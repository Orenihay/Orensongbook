    ['aug', 'מוגדל', [0, 4, 8], '1 3 #5'],
    ['sus2', 'sus2', [0, 2, 7], '1 2 5'],
    ['sus4', 'sus4', [0, 5, 7], '1 4 5'],
    ['7sus4', '7sus4', [0, 5, 7, 10], '1 4 5 b7'],
    ['6', 'שישית', [0, 4, 7, 9], '1 3 5 6'],
    ['m6', 'מינור 6', [0, 3, 7, 9], '1 b3 5 6'],
    ['add9', 'add9', [0, 4, 7, 14], '1 3 5 9'],
