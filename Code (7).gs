}


// ===== Code.gs =====
/**
 * Guitar Studio — entry points: web app, Sheets menu and the public API used by the client
 * (google.script.run). Functions ending in "_" are private and not callable from the client.
 */

const VIEWS = ['dashboard', 'songs', 'singers', 'favorites', 'playlists', 'add', 'settings', 'remote', 'song', 'playlist', 'singer', 'chords'];

function doGet(e) {
  const params = (e && e.parameter) || {};

  const view = params.view || 'dashboard';
  // The owner key is put in the page only when the link already carries the right key.
  const key = params.key && String(params.key) === ownerKey_() ? String(params.key) : '';
  // ?remote=CODE (from the projector screen) opens the phone remote for that TV.
  const remote = /^[A-HJ-NP-Z2-9]{5}$/.test(String(params.remote || '').toUpperCase()) ? String(params.remote).toUpperCase() : '';
  // ?view=song&id=… (also playlist / singer / chords): a direct link to one item.
  const id = /^[\w#/+-]{1,40}$/.test(String(params.id || '')) ? String(params.id) : '';
  return renderApp_(remote ? 'remote' : view, key, remote, id)
    .setTitle(APP.NAME)
    .addMetaTag('viewport', 'width=device-width, initial-scale=1, viewport-fit=cover');
}

function renderApp_(view, ownerKey, remoteCode, itemId) {
  const t = HtmlService.createTemplateFromFile('Index');
  t.initialView = VIEWS.indexOf(view) >= 0 ? view : 'dashboard';
  t.ownerKey = ownerKey || '';
  t.remoteCode = remoteCode || '';
  t.initialId = itemId || '';
  // Never blocks: if Index.html differs from the one built with this Code.gs, the loading screen
  // explains how to re-paste it — only shown if the page then fails to start.
  t.indexCheck = indexIntact_() === false ? 'bad' : '';
  return t.evaluate();
}

/**
 * true / false when the deployed Index.html matches / does not match the one built with this Code.gs
 * (whitespace ignored); null when it cannot be checked (development runs, read errors).
 */
function indexIntact_() {
  try {
    if (typeof INDEX_FINGERPRINT === 'undefined' || !INDEX_FINGERPRINT) return null;
    const text = HtmlService.createHtmlOutputFromFile('Index').getContent().replace(/\s+/g, '');
    const bytes = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, text, Utilities.Charset.UTF_8);
    const hex = bytes.map((b) => ((b + 256) % 256).toString(16).padStart(2, '0')).join('');
    return hex === INDEX_FINGERPRINT;
  } catch (e) {
    return null;
  }
}

/** The data-build of the Index file deployed with this code (to diagnose partial updates). */
function indexBuild_() {
  try {
    const cache = CacheService.getScriptCache();
    const hit = cache.get('gs_index_build_' + APP.VERSION);
    if (hit) return hit;
    const m = /data-build="([^"]+)"/.exec(HtmlService.createHtmlOutputFromFile('Index').getContent());
    const build = m ? m[1] : '';
    if (build) cache.put('gs_index_build_' + APP.VERSION, build, 600);
    return build;
  } catch (e) {
    return '';
  }
}

function include_(name) {
  return HtmlService.createHtmlOutputFromFile(name).getContent();
}

/** Injects the exact server-side chord engine into the client page. */
function chordEngineSource_() {
  const src = ChordEngineFactory_.toString();
  if (src.indexOf('parseSong') < 0) throw new Error('Chord engine source unavailable in this runtime.');
  return 'var ChordEngine = (' + src + ')();';
}

// ------------------------------------------------------------------ access: owner edits, everyone else views

/** Owners: the account the web app runs as, plus ALLOWED_EMAILS (comma separated) if set. */
function ownerEmails_() {
  const owner = String(Session.getEffectiveUser().getEmail() || '').toLowerCase();
  return (PropertiesService.getScriptProperties().getProperty('ALLOWED_EMAILS') || '')
    .split(',')
    .map((x) => x.trim().toLowerCase())
    .concat([owner])
    .filter(Boolean);
}

/** Owner key (fallback when Google does not reveal the signed-in owner): open the app with ?key=… */
function ownerKey_() {
  const props = PropertiesService.getScriptProperties();
  let key = props.getProperty('OWNER_KEY');
  if (!key) {
    key = Utilities.getUuid().replace(/-/g, '').slice(0, 16);
    props.setProperty('OWNER_KEY', key);
  }
  return key;
}

/** The client appends {__auth:true, key} as the last argument of every call. */
function authOf_(args) {
  const last = args && args.length ? args[args.length - 1] : null;
  return last && typeof last === 'object' && last.__auth ? last : {};
}

function isOwner_(auth) {
  const active = String(Session.getActiveUser().getEmail() || '').toLowerCase();
  if (active && ownerEmails_().indexOf(active) >= 0) return true;
  const key = auth && auth.key ? String(auth.key) : '';
  return !!key && key === ownerKey_();
}

/** Reads: anyone who can open the web app (the deployment decides who that is). */
function read_(auth, fn) {
  return fn(isOwner_(auth) ? 'owner' : 'viewer');
}

/** Writes and anything costly or private: the owner only — enforced here, not just in the UI. */
function write_(auth, fn) {
  if (!isOwner_(auth)) throw new Error('מצב צפייה: רק בעל הספרייה יכול להוסיף או לשנות.');
  return fn();
}

/** Kept for the Sheets menu and editor runs (always the owner). */
function api_(fn) {
  return write_({}, fn);
}

/** What a viewer may see: no hidden songs outside playlists, no personal notes, no admin data. */
function viewerLibrary_(lib) {
  const inPlaylist = {};
  (lib.playlists || []).forEach((pl) => pl.songs.forEach((id) => (inPlaylist[id] = true)));
  const songs = lib.songs
    .filter((s) => !s.Hidden || inPlaylist[s.SongID])
    .map((s) => {
      const c = Object.assign({}, s);
      delete c.PersonalNotes;
      return c;
    });
  return Object.assign({}, lib, { songs, spreadsheetUrl: '', settings: {} });
}

/**
 * Runs a write, then the Drive JSON backup. With attach, the backup outcome is added to the
 * result as `backup` (so the UI can warn if Drive failed); a duplicate-guard result is no write.
 */
function withBackup_(reason, force, attach, fn) {
  const res = fn();
  if (res && res.status === 'duplicate') return res;
  // The JSON backup is written moments later by apiFlushBackup (called by the page in the
  // background), so saving is not held up by Drive. Until then the change is marked pending.
  markBackupPending_(reason);
  if (attach && res && typeof res === 'object' && !Array.isArray(res)) res.backup = { status: 'pending' };
  return res;
}

