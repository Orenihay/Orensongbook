.cl-dg.big { max-width:none; }
.cl-pos { font-size:12px; color:var(--muted); }
.cl-arrow { width:44px; height:44px; border-radius:50%; border:1px solid var(--border); background:var(--surface-2); color:var(--text); font-size:26px; line-height:1; cursor:pointer; }
.cl-pick { background:var(--surface); border:1px solid var(--border); border-radius:18px; padding:12px 14px; margin-bottom:14px; }
.cl-lbl { font-size:12px; color:var(--muted); margin:8px 2px 6px; }
.cl-roots { display:grid; grid-template-columns:repeat(12, minmax(0,1fr)); gap:5px; direction:ltr; }
.cl-key { border:1px solid var(--border); background:var(--surface-2); color:var(--text); border-radius:10px; height:40px; font:inherit; font-weight:700; cursor:pointer; }
.cl-key.on { background:var(--accent); border-color:var(--accent); color:var(--bg); }
