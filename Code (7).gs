.cl-cat { flex:1 0 auto; border:0; background:none; color:var(--muted); border-radius:9px; padding:7px 10px; font:inherit; font-size:13px; font-weight:600; cursor:pointer; }
.cl-cat.on { background:var(--surface); color:var(--text); box-shadow:0 1px 4px #0004; }
.cl-strip { display:flex; gap:6px; overflow-x:auto; padding:2px 2px 8px; scroll-snap-type:x proximity; scrollbar-width:thin; scrollbar-color:var(--border) transparent; }
.cl-strip > * { scroll-snap-align:start; }
.cl-strip::-webkit-scrollbar { height:6px; } .cl-strip::-webkit-scrollbar-thumb { background:var(--border); border-radius:6px; }
