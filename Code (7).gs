      <div class="cl-under">
        <div class="cl-seg" role="group" aria-label="על הנקודות">${[['finger', 'אצבעות'], ['deg', 'דרגות'], ['note', 'תווים']].map(([k, l]) => `<button class="${s.label === k ? 'on' : ''}" data-cl="label" data-v="${k}">${l}</button>`).join('')}</div>
        <label class="chip-toggle"><input type="checkbox" data-cl="all" ${s.all ? 'checked' : ''}> כל צלילי האקורד על הלוח (CAGED)</label>
