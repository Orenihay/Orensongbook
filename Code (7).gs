/**
 * Guitar Studio — backup export and merge-restore.
 * Export includes every column (also user-added ones). Restore only ADDS records whose key does
 * not exist yet; existing records are never overwritten or deleted.
 */

/** Lazy so file load order in the Apps Script project does not matter. */
function backupSheets_() {
  return [SHEET.SINGERS, SHEET.SONGS, SHEET.PLAYLISTS, SHEET.PLAYLIST_SONGS, SHEET.CHORDS, SHEET.PRACTICE, SHEET.SETTINGS];
}

function exportBackup_() {
  const data = {};
  backupSheets_().forEach((name) => {
    const t = table_(name);
    const pk = PRIMARY_KEY[name];
    data[name] = t.rows.map((r) => rowObj_(t, r)).filter((o) => pk.every((k) => String(o[k]).trim()));
  });
  return {
    appName: APP.NAME,
    appVersion: APP.VERSION,
    exportVersion: APP.EXPORT_VERSION,
    schemaVersion: APP.SCHEMA_VERSION,
    createdAt: isoNow_(),
    fileName: `${APP.SLUG}-v${APP.VERSION}-backup-${isoNow_().slice(0, 10)}.json`,
    counts: Object.keys(data).reduce((o, k) => ((o[k] = data[k].length), o), {}),
    data,
  };
}

function importBackup_(backup) {
  const known = [APP.NAME].concat(APP.LEGACY_NAMES);
  if (!backup || known.indexOf(backup.appName) < 0 || typeof backup.data !== 'object') {
    throw new Error(`הקובץ אינו גיבוי תקין של ${APP.NAME}.`);
  }
  if (Number(backup.schemaVersion) > APP.SCHEMA_VERSION) {
    throw new Error(`הגיבוי נוצר בגרסת מבנה ${backup.schemaVersion}, חדשה מהגרסה המותקנת (${APP.SCHEMA_VERSION}).`);
  }
  return withLock_(() => {
    const summary = {};
    backupSheets_().forEach((name) => {
      const records = Array.isArray(backup.data[name]) ? backup.data[name] : [];
      const t = table_(name);
      const pk = PRIMARY_KEY[name];
      const keyOf = (o) => pk.map((k) => String(o[k] === undefined ? '' : o[k]).trim()).join('|');
      const have = {};
      t.rows.forEach((r) => (have[keyOf(rowObj_(t, r))] = true));
      const fields = t.headers.filter(Boolean);
      const toAdd = [];
      records.forEach((rec) => {
        if (!rec || typeof rec !== 'object') return;
        const k = keyOf(rec);
        if (!k.replace(/\|/g, '') || have[k]) return;
        have[k] = true;
        const o = {};
        fields.forEach((f) => (o[f] = f in rec ? rec[f] : ''));
        toAdd.push(o);
      });
      appendObjs_(t, toAdd, fields);
      summary[name] = { added: toAdd.length, skipped: records.length - toAdd.length };
    });
    invalidateCache_();
    return summary;
  });
}


