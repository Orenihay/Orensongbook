  }

  function neckTab(tuningRow, cams) {
    const s = UI.state;
    const sc = SCALES.find((x) => x.id === s.scale) || SCALES[0];
    const rootPc = noteIndex(s.scaleRoot);
    const flats = /b/.test(s.scaleRoot) || s.scaleRoot === 'F';
    const marks = neckMap(rootPc, sc.iv, s.tuning, FRETS).map((m) => ({ s: m.s, f: m.f, midi: m.midi, cls: degClass(m.deg), text: s.scaleLabel === 'note' ? noteName(m.midi, flats) : m.deg, small: true }));
    const tuning = tuningById(s.tuning);
    return `
      <section class="cl-hero" aria-label="הסולם">
        <div class="cl-hero-main">
          <div class="cl-title"><span class="cl-name">${esc(s.scaleRoot)}</span><span class="cl-he">${esc(sc.he)}</span></div>
          <div class="cl-info">
            <span class="cl-fact"><b>צלילים</b> <bdi>${esc(sc.iv.map((i) => noteName(rootPc + i, flats)).join(' · '))}</bdi></span>
            <span class="cl-fact"><b>דרגות</b> <bdi>${esc(sc.iv.map((i) => degreeLabel(pc(i), sc.iv)).join(' · '))}</bdi></span>
          </div>
          <div class="cl-play"><button class="btn btn-accent" data-cl="play" data-v="scale">▶ השמע סולם</button></div>
        </div>
      </section>
      <section class="cl-pick" aria-label="בחירת סולם">
        <div class="cl-lbl">טוניקה</div>
        <div class="cl-roots">${ROOTS.map((r) => `<button class="cl-key ${r === s.scaleRoot ? 'on' : ''}" data-cl="sroot" data-v="${r}">${r}</button>`).join('')}</div>
        <div class="cl-lbl">סולם</div>
        <div class="cl-strip cl-quals">${SCALES.map((x) => `<button class="cl-pill ${x.id === s.scale ? 'on' : ''}" data-cl="scale" data-v="${x.id}"><span>${esc(x.he)}</span><small>${x.iv.length} צלילים</small></button>`).join('')}</div>
        <div class="cl-selects"><label>כיוון <select id="cl-tuning" aria-label="כיוון הגיטרה">${TUNINGS.map((t) => `<option value="${t.id}" ${t.id === s.tuning ? 'selected' : ''}>${esc(t.he)} · ${esc(t.label)}</option>`).join('')}</select></label></div>
      </section>
      ${cams}
      <div class="cl-stage ${UI.cam.mode === 'orbit' ? 'orbit' : ''}" id="cl-stage"><div class="cl-neck3d" id="cl-neck3d" style="transform:${camTransform()}">${neckSvg(marks, { tuningNames: tuning.label.split(' '), label: s.scaleRoot + ' ' + sc.he })}</div></div>
      <div class="cl-under">
        <div class="cl-seg" role="group" aria-label="על הנקודות">${[['deg', 'דרגות'], ['note', 'תווים']].map(([k, l]) => `<button class="${s.scaleLabel === k ? 'on' : ''}" data-cl="slabel" data-v="${k}">${l}</button>`).join('')}</div>
        <div class="cl-legend"><span><i style="background:var(--deg-r)"></i>R = טוניקה</span><span><i style="background:var(--deg-3)"></i>טרצה</span><span><i style="background:var(--deg-5)"></i>קווינטה</span><span><i style="background:var(--deg-7)"></i>ספטימה</span></div>
      </div>
      <div class="cl-note">הקשה על נקודה משמיעה אותה.</div>`;
  }

  function bindStage() {
    const stage = UI.root.querySelector('#cl-stage');
    const neck = UI.root.querySelector('#cl-neck3d');
    if (!stage || !neck) return;
    // On narrow screens the neck scrolls sideways: bring the shown position into view (nut side first).
    if (stage.scrollWidth > stage.clientWidth + 2) {
      const dots = Array.from(stage.querySelectorAll('.nd circle'));
      const fretted = UI.state.tab === 'chord' && !UI.state.all ? dots.filter((c) => +c.getAttribute('cx') > NECK.x0) : [];
      if (fretted.length) {
        const sr = stage.getBoundingClientRect();
        const xs = fretted.map((c) => c.getBoundingClientRect()).map((r) => r.left - sr.left + stage.scrollLeft);
        const lo = Math.min.apply(null, xs);
        const hi = Math.max.apply(null, xs);
        stage.scrollLeft = Math.max(0, (lo + hi) / 2 - stage.clientWidth / 2);
      } else stage.scrollLeft = 0;
    }
    let drag = null;
    on(stage, 'pointerdown', (e) => {
      if (UI.cam.mode !== 'orbit' || e.target.closest('.nd')) return;
      drag = { x: e.clientX, y: e.clientY, rx: UI.cam.rx, ry: UI.cam.ry };
      neck.classList.add('drag');
      try { stage.setPointerCapture(e.pointerId); } catch (err) { /* ignore */ }
    });
    on(stage, 'pointermove', (e) => {
      if (!drag) return;
      UI.cam.ry = Math.max(-70, Math.min(70, drag.ry + (e.clientX - drag.x) * 0.4));
      UI.cam.rx = Math.max(-10, Math.min(75, drag.rx - (e.clientY - drag.y) * 0.4));
      neck.style.transform = camTransform();
    });
    const end = () => { if (drag) { drag = null; neck.classList.remove('drag'); } };
    on(stage, 'pointerup', end);
    on(stage, 'pointercancel', end);
    on(stage, 'wheel', (e) => {
      if (UI.cam.mode !== 'orbit') return;
      e.preventDefault();
      UI.cam.z = Math.max(0.6, Math.min(2.2, UI.cam.z * (e.deltaY > 0 ? 0.92 : 1.08)));
      neck.style.transform = camTransform();
    }, { passive: false });
  }

  function vibrate(strings, ms) {
    if (!UI.root) return;
    strings.forEach((st) => {
      const el = UI.root.querySelector(`.cl-neck .str[data-s="${st}"]`);
      if (!el) return;
      el.classList.remove('vib');
      void el.getBoundingClientRect();
      el.classList.add('vib');
      later(() => el.classList.remove('vib'), ms || 1600);
    });
  }

  function play(kind) {
    const s = UI.state;
    const tuning = tuningById(s.tuning);
    if (kind === 'scale') {
      const sc = SCALES.find((x) => x.id === s.scale) || SCALES[0];
      const base = 48 + noteIndex(s.scaleRoot);
      const notes = sc.iv.concat([12]).map((i) => ({ midi: base + i }));
      playNotes(notes, 260, 0.8);
      return;
    }
    const ch = current();
    const vs = voicings(ch, s.tuning, 8);
    const v = vs[Math.min(s.vi, vs.length - 1)];
    if (!v) return;
    const strs = v.frets.map((f, i) => (f === null ? null : { s: i, midi: tuning.midi[i] + f })).filter(Boolean);
    let seq = strs;
    let gap = 22;
    if (kind === 'up') seq = strs.slice().reverse();
    if (kind === 'arp') { seq = strs.concat(strs.slice(1, -1).reverse()); gap = 190; }
    if (kind === 'travis') {
      // Alternating bass (thumb) with a pinch: bass, top, alt-bass, middle, bass+top...
      const bass = strs[0];
      const alt = strs[Math.min(1, strs.length - 1)];
      const top = strs[strs.length - 1];
      const mid = strs[Math.max(0, strs.length - 2)];
      seq = [bass, top, alt, mid, bass, top, alt, mid];
      gap = 210;
    }
    if (playNotes(seq, gap, kind === 'down' || kind === 'up' ? 0.85 : 0.75)) vibrate(Array.from(new Set(seq.map((x) => x.s))), kind === 'down' || kind === 'up' ? 1600 : seq.length * gap + 900);
  }

  function onClick(e) {
    if (!e.target.closest('#cl-q')) clearTimeout(UI.typeT);
    const nd = e.target.closest('.nd');
    if (nd) { playNotes([{ midi: +nd.dataset.midi }], 0, 0.85); vibrate([+nd.dataset.s], 1200); return; }
    const b = e.target.closest('[data-cl]');
    if (!b) return;
    const s = UI.state;
    const v = b.dataset.v;
    switch (b.dataset.cl) {
      case 'tab': s.tab = v; break;
      case 'root': s.root = v; s.bass = ''; s.vi = 0; break;
      case 'q': s.suffix = v; s.bass = ''; s.vi = 0; s.cat = ''; break;
      case 'cat': s.cat = v; draw(); return;
      case 'shift': { const n = shift(current(), +v); if (n) Object.assign(s, { root: n.root, suffix: n.suffix, bass: n.bass, vi: 0 }); break; }
      case 'vstep': stepVoicing(+v); return;
      case 'mine-all': s.mineAll = !s.mineAll; draw(); return;
      case 'bass': s.bass = v; s.vi = 0; break;
      case 'pick': applyQuery(v); save(); return;
      case 'query': applyQuery(UI.root.querySelector('#cl-q').value); save(); return;
      case 'voicing': s.vi = +v; s.all = false; draw(); play('down'); save(); return;
      case 'label': s.label = v; break;
      case 'cam': UI.cam.mode = v; if (v === 'orbit') Object.assign(UI.cam, { rx: 35, ry: -18, z: 1 }); break;
      case 'play': play(v); return;
      case 'sroot': s.scaleRoot = v; break;
      case 'scale': s.scale = v; break;
      case 'slabel': s.scaleLabel = v; break;
      default: return;
    }
    save();
    draw();
  }

  function onChange(e) {
    const s = UI.state;
    if (e.target.id === 'cl-tuning') { s.tuning = e.target.value; s.vi = 0; }
    else if (e.target.dataset && e.target.dataset.cl === 'bass-sel') { s.bass = e.target.value; s.vi = 0; }
    else if (e.target.dataset && e.target.dataset.cl === 'all') s.all = e.target.checked;
    else return;
    save();
    draw();
  }

  return { theory, mount, unmount, isMounted: () => !!UI.root, audioOpen: () => !!A.ctx };
}

/** What the page loads on first use of the chord library (never part of the initial page). */
