/**
 * Defensive normalization: the schema guarantees shape, not musical validity. Junk lines are
 * limited to non-musical lines (never chord lines or section labels), and ignored entirely if the
 * model flags an implausible share of the text.
 */
function sanitizeAiResult_(r, lines) {
  const lineCount = lines.length;
  const key = r.originalKey ? String(r.originalKey).trim().replace(/^([a-g])/, (c) => c.toUpperCase()) : '';
  return {
    songName: toText_(r.songName, 200).trim(),
    artist: toText_(r.artist, 150).trim(),
    confidence: ['high', 'medium', 'low'].indexOf(r.confidence) >= 0 ? r.confidence : 'low',
    originalKey: ChordEngine.parseKey(key) ? key : '',
    capo: r.capo === null || r.capo === undefined ? '' : toInt_(r.capo, 0, 12, ''),
    language: toEnum_(r.language, LIST_DEFAULTS.Language, ''),
    genre: r.genre ? toText_(r.genre, 80).trim() : '',
    tuning: r.tuning && r.tuning !== 'Unknown' ? toEnum_(r.tuning, LIST_DEFAULTS.Tuning, '') : '',
    bpm: r.bpm === null || r.bpm === undefined ? '' : toInt_(r.bpm, 20, 400, ''),
    difficulty: toEnum_(r.difficulty, ENUM.Difficulty, ''),
    playingStyle: r.playingStyle ? toEnum_(r.playingStyle, LIST_DEFAULTS.PlayingStyle, '') : '',
    strummingPattern: r.strummingPattern ? toText_(r.strummingPattern, 200).trim() : '',
    junkLines: safeJunk_(r.junkLines, lines),
    notes: toText_(r.notes || '', 300).trim(),
  };
}

function safeJunk_(junk, lines) {
  const idx = Array.from(new Set((junk || []).filter((n) => Number.isInteger(n) && n >= 0 && n < lines.length)))
    .filter((n) => lines[n].trim() && !ChordEngine.analyzeLine(lines[n]) && !ChordEngine.sectionLabel(lines[n]));
  const nonBlank = lines.filter((l) => l.trim()).length;
  return idx.length > Math.max(3, nonBlank * 0.25) ? [] : idx;
}


