function menuRepair() {
  const fixed = api_(() => withLock_(() => repairData_().fixed));
  invalidateCache_();
  SpreadsheetApp.getActive().toast(`עודכנו ${fixed} רשומות`, APP.NAME);
}

function menuSnapshot() {
  const made = apiSnapshot();
  SpreadsheetApp.getActive().toast(made.length ? `נוצרו: ${made.join(', ')}` : 'אין עדיין נתונים לגבות', APP.NAME);
