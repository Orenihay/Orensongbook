    { id: 'dropd', he: 'Drop D', label: 'D A D G B E', midi: [38, 45, 50, 55, 59, 64] },
    { id: 'half', he: 'חצי טון למטה', label: 'Eb Ab Db Gb Bb Eb', midi: [39, 44, 49, 54, 58, 63] },
