  const SCALES = [
    { id: 'major', he: 'מז׳ור (יוני)', iv: [0, 2, 4, 5, 7, 9, 11] },
    { id: 'minor', he: 'מינור טבעי', iv: [0, 2, 3, 5, 7, 8, 10] },
    { id: 'pentaMaj', he: 'פנטטוני מז׳ור', iv: [0, 2, 4, 7, 9] },
    { id: 'pentaMin', he: 'פנטטוני מינור', iv: [0, 3, 5, 7, 10] },
    { id: 'blues', he: 'בלוז', iv: [0, 3, 5, 6, 7, 10] },
    { id: 'dorian', he: 'דורי', iv: [0, 2, 3, 5, 7, 9, 10] },
    { id: 'mixo', he: 'מיקסולידי', iv: [0, 2, 4, 5, 7, 9, 10] },
    { id: 'harmMin', he: 'מינור הרמוני', iv: [0, 2, 3, 5, 7, 8, 11] },
  ];

