  /** Fingers for frets (6 low->high, null = muted). Barre with finger 1 when the lowest fret repeats. */
  function fingersFor(frets) {
    const pressed = frets.map((f, s) => ({ f, s })).filter((x) => x.f > 0);
    if (!pressed.length) return frets.map(() => 0);
    const min = Math.min.apply(null, pressed.map((x) => x.f));
    const out = frets.map(() => 0);
    const atMin = pressed.filter((x) => x.f === min);
    let next = 1;
    if (atMin.length >= 2) { atMin.forEach((x) => (out[x.s] = 1)); next = 2; }
