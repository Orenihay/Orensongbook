// ===== Db.gs =====
/**
 * Guitar Studio — data layer over Google Sheets.
 * - Columns are located by header name, so users may reorder or add their own columns.
 * - Only the cells being changed are written (user formulas/columns are never overwritten).
 * - All writes run under a script lock; the library payload is cached in CacheService.
 */

let ss__ = null;

function ss_() {
  if (ss__) return ss__;
  const id = PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');
  ss__ = id
    ? SpreadsheetApp.openById(id)
    : SpreadsheetApp.getActiveSpreadsheet() || SpreadsheetApp.openById(APP.DEFAULT_SPREADSHEET_ID);
  return ss__;
}

function withLock_(fn) {
  const lock = LockService.getScriptLock();
  lock.waitLock(APP.LOCK_TIMEOUT_MS);
  try {
    return fn();
  } finally {
    lock.releaseLock();
  }
}

function isoNow_() {
  return new Date().toISOString();
}

function newId_(prefix) {
  return prefix + '-' + Utilities.getUuid().replace(/-/g, '').slice(0, 10).toUpperCase();
}

// ------------------------------------------------------------------ cell conversion

/** Forces text for values Sheets would otherwise turn into formulas, numbers, dates or booleans. */
function cellIn_(v) {
  if (v === null || v === undefined) return '';
  if (typeof v !== 'string') return v;
  // Leading whitespace is part of chord alignment; the quote prefix keeps the cell exactly as written.
  return /^[=+\-@'\d.$%\s]|^(true|false)$/i.test(v) ? "'" + v : v;
}

function cellOut_(v) {
  if (v instanceof Date || Object.prototype.toString.call(v) === '[object Date]') {
    return isNaN(v.getTime()) ? '' : v.toISOString();
  }
  return v === null || v === undefined ? '' : v;
}

function toBool_(v) {
  return v === true || /^(true|1|yes|כן|v|x)$/i.test(String(v).trim());
}

function toInt_(v, min, max, fallback) {
  if (v === '' || v === null || v === undefined) return fallback;
  const n = Math.round(Number(v));
  if (!isFinite(n)) return fallback;
  return Math.min(max, Math.max(min, n));
}

function toText_(v, max) {
  const s = String(v === null || v === undefined ? '' : v);
  return s.length > (max || 500) ? s.slice(0, max || 500) : s;
}

function toUrl_(v) {
  const s = String(v || '').trim();
  return /^https?:\/\/\S+$/i.test(s) ? s.slice(0, 2000) : '';
}

function toKey_(v) {
  const s = String(v || '').trim();
  return ChordEngine.parseKey(s) ? s : '';
}

function toEnum_(v, allowed, fallback) {
  return allowed.indexOf(v) >= 0 ? v : fallback;
}

// ------------------------------------------------------------------ tables

/** Header row of a sheet: { name, sh, headers, col }. Validates the schema columns. */
function sheetInfo_(name) {
  const sh = ss_().getSheetByName(name);
  if (!sh) throw new Error(`הלשונית "${name}" חסרה. הפעל "הקמה / עדכון מבנה" מתפריט ${APP.NAME}.`);
  const lastCol = sh.getLastColumn();
  const headers = lastCol ? sh.getRange(1, 1, 1, lastCol).getValues()[0].map((h) => String(h).trim()) : [];
  const col = {};
  headers.forEach((h, i) => {
    if (h && !(h in col)) col[h] = i;
  });
  const missing = (SCHEMA[name] || []).filter((h) => !(h in col));
  if (missing.length) {
    throw new Error(`בלשונית "${name}" חסרות עמודות: ${missing.join(', ')}. הפעל "הקמה / עדכון מבנה".`);
  }
  return { name, sh, headers, col };
}

/**
 * Loads a sheet into memory: { name, sh, headers, col, rows }.
 * opts.skip: columns not to read (e.g. the large SongContent); they come back as ''.
 */
function table_(name, opts) {
  const info = sheetInfo_(name);
  const sh = info.sh;
  const n = sh.getLastRow() - 1;
  const width = info.headers.length;
  let rows = [];
  if (n > 0 && width) {
    const skip = ((opts && opts.skip) || []).map((f) => info.col[f]).filter((c) => c !== undefined);
    if (!skip.length) rows = sh.getRange(2, 1, n, width).getValues();
    else {
      rows = Array.from({ length: n }, () => new Array(width).fill(''));
      let c = 0;
      while (c < width) {
        if (skip.indexOf(c) >= 0) { c++; continue; }
        let e = c;
        while (e + 1 < width && skip.indexOf(e + 1) < 0) e++;
        const block = sh.getRange(2, c + 1, n, e - c + 1).getValues();
        for (let i = 0; i < n; i++) for (let k = c; k <= e; k++) rows[i][k] = block[i][k - c];
        c = e + 1;
      }
    }
  }
  return { name, sh, headers: info.headers, col: info.col, rows };
}

/** Reads only some columns of every data row: { info, n, data: { field: values[] } }. */
function columns_(name, fields) {
  const info = sheetInfo_(name);
  const n = info.sh.getLastRow() - 1;
  const data = {};
  fields.forEach((f) => (data[f] = []));
  if (n < 1) return { info, n: 0, data };
  const cols = fields.map((f) => info.col[f]);
  const lo = Math.min.apply(null, cols);
  const hi = Math.max.apply(null, cols);
  if (hi - lo < fields.length + 3) {
    const block = info.sh.getRange(2, lo + 1, n, hi - lo + 1).getValues();
    fields.forEach((f, k) => (data[f] = block.map((r) => r[cols[k] - lo])));
  } else {
    fields.forEach((f, k) => (data[f] = info.sh.getRange(2, cols[k] + 1, n, 1).getValues().map((r) => r[0])));
  }
  return { info, n, data };
}

/**
 * Finds one row by id reading only the id column, then reads just that row.
 * Returns { t, idx, row } where t holds only this row (enough for updateObj_), or null.
 */
function locate_(name, idField, id) {
  const ids = columns_(name, [idField]);
  const want = String(id);
  const idx = ids.data[idField].findIndex((v) => String(v) === want);
  if (idx < 0) return null;
  const info = ids.info;
  const row = info.sh.getRange(idx + 2, 1, 1, info.headers.length).getValues()[0];
  const t = { name, sh: info.sh, headers: info.headers, col: info.col, rows: [] };
  t.rows[idx] = row;
  return { t, idx, row };
}

/** An empty table handle positioned for appending after `n` existing data rows. */
function appendHandle_(info, n) {
  return { name: info.name, sh: info.sh, headers: info.headers, col: info.col, rows: new Array(n) };
}

function rowObj_(t, row) {
  const o = {};
  t.headers.forEach((h, i) => {
    if (h) o[h] = cellOut_(row[i]);
  });
  return o;
}

function findIndex_(t, field, value) {
  const c = t.col[field];
  const v = String(value);
  for (let i = 0; i < t.rows.length; i++) if (String(t.rows[i][c]) === v) return i;
  return -1;
}

function ensureCapacity_(sh, lastRowNeeded) {
  const max = sh.getMaxRows();
  if (lastRowNeeded > max) sh.insertRowsAfter(max, lastRowNeeded - max);
}

/**
 * Writes `fields` of `objs` into consecutive data rows starting at `startIdx` (0 = first data row).
 * Writes contiguous column runs only, so other columns stay untouched.
 */
function writeBlock_(t, startIdx, objs, fields) {
  if (!objs.length || !fields.length) return;
  ensureCapacity_(t.sh, startIdx + objs.length + 1);
  const cols = fields.map((f) => t.col[f]).sort((a, b) => a - b);
  let i = 0;
  while (i < cols.length) {
    let j = i;
    while (j + 1 < cols.length && cols[j + 1] === cols[j] + 1) j++;
    const values = objs.map((o) => {
      const r = [];
      for (let c = cols[i]; c <= cols[j]; c++) r.push(cellIn_(o[t.headers[c]]));
      return r;
    });
    t.sh.getRange(startIdx + 2, cols[i] + 1, objs.length, j - i + 1).setValues(values);
    i = j + 1;
  }
  objs.forEach((o, k) => {
    const idx = startIdx + k;
    if (!t.rows[idx]) t.rows[idx] = t.headers.map(() => '');
    fields.forEach((f) => (t.rows[idx][t.col[f]] = o[f]));
  });
}

function appendObjs_(t, objs, fields) {
  writeBlock_(t, t.rows.length, objs, fields || SCHEMA[t.name]);
}

function updateObj_(t, idx, before, after) {
  const changed = SCHEMA[t.name].filter((f) => f in after && String(before[f]) !== String(after[f]));
  writeBlock_(t, idx, [after], changed);
  return changed;
}

// ------------------------------------------------------------------ records

function songFromRow_(t, row) {
  const o = rowObj_(t, row);
  const s = {};
  SCHEMA.Songs.forEach((f) => (s[f] = o[f] === undefined ? '' : o[f]));
  ['SongID', 'SongName', 'ArtistID', 'SongContent', 'ChordsUsed', 'OriginalKey', 'PersonalKey'].forEach(
    (f) => (s[f] = String(s[f]))
  );
  s.IsFavorite = toBool_(s.IsFavorite);
  s.Hidden = toBool_(s.Hidden);
  s.Capo = toInt_(s.Capo, 0, 12, '');
  s.BPM = toInt_(s.BPM, 1, 999, '');
  s.Transpose = toInt_(s.Transpose, -11, 11, 0);
  return s;
}

function singerFromRow_(t, row) {
  const o = rowObj_(t, row);
  const s = {};
  SCHEMA.Singers.forEach((f) => (s[f] = o[f] === undefined ? '' : o[f]));
  s.SingerID = String(s.SingerID);
  s.SingerName = String(s.SingerName);
  s.IsFavorite = toBool_(s.IsFavorite);
  s.AutoPlaylists = String(s.AutoPlaylists || '').trim();
  return s;
}

function songMeta_(s) {
  const m = Object.assign({}, s);
  delete m.SongContent;
  m.HasContent = !!s.SongContent;
  return m;
}

function songKey_(name, artistId) {
  return ChordEngine.normalizeName(name) + '|' + artistId;
}

/** Validates and normalizes user input into a Songs record (without IDs/dates). */
function sanitizeSong_(input) {
  const content = ChordEngine.normalizeText(input.SongContent || '');
  if (content.length > APP.MAX_TEXT) throw new Error('תוכן השיר ארוך מדי (מעל 45,000 תווים).');
  const name = toText_(input.SongName, 200).trim();
  if (!name) throw new Error('שם השיר הוא שדה חובה.');
  const original = toKey_(input.OriginalKey);
  let personal = toKey_(input.PersonalKey);
  let transpose = toInt_(input.Transpose, -11, 11, 0);
  if (original && personal) transpose = ChordEngine.semitonesBetween(original, personal);
  else if (original && transpose) personal = ChordEngine.transposeKey(original, transpose);
  return {
    SongName: name,
    Language: toText_(input.Language, 50),
    Genre: toText_(input.Genre, 80),
    OriginalKey: original,
    PersonalKey: personal,
    Transpose: transpose,
    Capo: toInt_(input.Capo, 0, 12, ''),
    Difficulty: toEnum_(input.Difficulty, ENUM.Difficulty, ''),
    BPM: toInt_(input.BPM, 20, 400, ''),
    ChordProgression: toText_(input.ChordProgression, 1000),
    ChordsUsed: ChordEngine.extractChords(content).join(' '),
    SongContent: content,
    StrummingPattern: toText_(input.StrummingPattern, 200),
    PlayingStyle: toText_(input.PlayingStyle, 50),
    Tuning: toText_(input.Tuning, 50),
    YouTubeURL: toUrl_(input.YouTubeURL),
    SpotifyURL: toUrl_(input.SpotifyURL),
    ChordsSourceURL: toUrl_(input.ChordsSourceURL),
    IsFavorite: toBool_(input.IsFavorite),
    LearningStatus: toEnum_(input.LearningStatus, ENUM.LearningStatus, 'Not Started'),
    PersonalNotes: toText_(input.PersonalNotes, 5000),
    GuitarPreference: toText_(input.GuitarPreference, 50),
    ChordDirection: toEnum_(input.ChordDirection, CHORD_DIRECTIONS, ''),
    Hidden: toBool_(input.Hidden),
  };
}

function sanitizeSinger_(input) {
  const name = toText_(input.SingerName, 150).trim().replace(/\s+/g, ' ');
  if (!name) throw new Error('שם הזמר הוא שדה חובה.');
  return {
    SingerName: name,
    Type: toText_(input.Type, 50),
    Country: toText_(input.Country, 80),
    Language: toText_(input.Language, 50),
    MainGenre: toText_(input.MainGenre, 80),
    ImageURL: toUrl_(input.ImageURL),
    SpotifyURL: toUrl_(input.SpotifyURL),
    YouTubeURL: toUrl_(input.YouTubeURL),
    Notes: toText_(input.Notes, 5000),
    IsFavorite: toBool_(input.IsFavorite),
  };
}

// ------------------------------------------------------------------ singers

function findSingerByName_(t, name) {
  const key = ChordEngine.normalizeName(name);
  if (!key) return -1;
  const c = t.col.SingerName;
  for (let i = 0; i < t.rows.length; i++) {
    if (t.rows[i][t.col.SingerID] && ChordEngine.normalizeName(t.rows[i][c]) === key) return i;
  }
  return -1;
}

/** Returns {singer, created}; reuses an existing singer with the same normalized name. */
function findOrCreateSinger_(t, name) {
  const idx = findSingerByName_(t, name);
  if (idx >= 0) return { singer: singerFromRow_(t, t.rows[idx]), created: false };
  const now = isoNow_();
  const rec = Object.assign(sanitizeSinger_({ SingerName: name }), {
    SingerID: newId_('A'),
    DateAdded: now,
    UpdatedAt: now,
  });
  appendObjs_(t, [rec]);
  return { singer: rec, created: true };
}

function saveSinger_(input, opts) {
  opts = opts || {};
  const data = sanitizeSinger_(input);
  return withLock_(() => {
    const t = table_(SHEET.SINGERS);
    const dupIdx = findSingerByName_(t, data.SingerName);
    const dup = dupIdx >= 0 ? singerFromRow_(t, t.rows[dupIdx]) : null;
    if (dup && dup.SingerID !== input.SingerID && !opts.allowDuplicate) {
      return { status: 'duplicate', existing: dup };
    }
    const now = isoNow_();
    let rec;
    if (input.SingerID) {
      const idx = findIndex_(t, 'SingerID', input.SingerID);
      if (idx < 0) throw new Error('הזמר לא נמצא (ייתכן שנמחק).');
      const before = singerFromRow_(t, t.rows[idx]);
      rec = Object.assign({}, before, data, { UpdatedAt: now });
      updateObj_(t, idx, before, rec);
    } else {
      rec = Object.assign(data, { SingerID: newId_('A'), DateAdded: now, UpdatedAt: now });
      appendObjs_(t, [rec]);
    }
    patchCache_((lib) => upsertById_(lib.singers, 'SingerID', rec));
    return { status: 'saved', singer: rec };
  });
}

function updateSinger_(id, patch) {
  return withLock_(() => {
    const t = table_(SHEET.SINGERS);
    const idx = findIndex_(t, 'SingerID', id);
    if (idx < 0) throw new Error('הזמר לא נמצא.');
    const before = singerFromRow_(t, t.rows[idx]);
    const rec = Object.assign({}, before);
    SINGER_PATCHABLE.forEach((f) => {
      if (f in patch) rec[f] = f === 'IsFavorite' ? toBool_(patch[f]) : patch[f];
    });
    rec.UpdatedAt = isoNow_();
    updateObj_(t, idx, before, rec);
    patchCache_((lib) => upsertById_(lib.singers, 'SingerID', rec));
    return rec;
  });
}

function deleteSinger_(id) {
  return withLock_(() => {
    const linked = columns_(SHEET.SONGS, ['ArtistID']).data.ArtistID.filter((v) => String(v) === String(id)).length;
    if (linked) throw new Error(`לא ניתן למחוק: לזמר משויכים ${linked} שירים. מחק או העבר אותם קודם.`);
    const t = table_(SHEET.SINGERS);
    const idx = findIndex_(t, 'SingerID', id);
    if (idx < 0) throw new Error('הזמר לא נמצא.');
    t.sh.deleteRow(idx + 2);
    patchCache_((lib) => (lib.singers = lib.singers.filter((s) => s.SingerID !== id)));
    return { deleted: id };
  });
}

// ------------------------------------------------------------------ songs

function getSong_(id, markPlayed) {
  const loc = locate_(SHEET.SONGS, 'SongID', id);
  if (!loc) throw new Error('השיר לא נמצא (ייתכן שנמחק).');
  const song = songFromRow_(loc.t, loc.row);
  if (markPlayed) song.LastPlayed = markPlayed_(id);
  return song;
}

/** Bulk read for the client's song cache: full records for the given ids (one sheet read). */
function getSongs_(ids) {
  const want = {};
  (ids || []).slice(0, 2000).forEach((id) => (want[String(id)] = true));
  const t = table_(SHEET.SONGS);
  const out = {};
  t.rows.forEach((r) => {
    const id = String(r[t.col.SongID]);
    if (want[id]) out[id] = songFromRow_(t, r);
  });
  return out;
}

const PLAYED_KEY = 'gs_played_v1';

/** Records "last played" with one cell write; the library shows it through a small cache map. */
function markPlayed_(id) {
  const at = isoNow_();
  withLock_(() => {
    const loc = locate_(SHEET.SONGS, 'SongID', id);
    if (loc) writeBlock_(loc.t, loc.idx, [{ LastPlayed: at }], ['LastPlayed']);
  });
  try {
    const cache = CacheService.getScriptCache();
    const map = JSON.parse(cache.get(PLAYED_KEY) || '{}');
    map[String(id)] = at;
    const keep = Object.keys(map).sort((a, b) => String(map[b]).localeCompare(String(map[a]))).slice(0, 100);
    const trimmed = {};
    keep.forEach((k) => (trimmed[k] = map[k]));
    cache.put(PLAYED_KEY, JSON.stringify(trimmed), APP.CACHE_TTL_SEC);
  } catch (e) {
    console.warn('played map failed', e);
  }
  return at;
}

function overlayPlayed_(lib) {
  try {
    const map = JSON.parse(CacheService.getScriptCache().get(PLAYED_KEY) || '{}');
    lib.songs.forEach((s) => {
      const at = map[s.SongID];
      if (at && String(at) > String(s.LastPlayed || '')) s.LastPlayed = at;
    });
  } catch (e) {
    console.warn('played overlay failed', e);
  }
  return lib;
}

/**
 * Creates or updates a song. Artist is given by ArtistID or ArtistName (matched/created by
 * normalized name). Returns {status:'duplicate', existing} when the same song+artist exists
 * and opts.allowDuplicate is not set.
 */
function saveSong_(input, opts) {
  opts = opts || {};
  const data = sanitizeSong_(input);
  return withLock_(() => {
    const singers = table_(SHEET.SINGERS);
    const keys = columns_(SHEET.SONGS, ['SongID', 'SongName', 'ArtistID']);

    let singer = null;
    let singerCreated = false;
    if (input.ArtistID) {
      const i = findIndex_(singers, 'SingerID', input.ArtistID);
      if (i < 0) throw new Error('הזמר שנבחר לא נמצא.');
      singer = singerFromRow_(singers, singers.rows[i]);
    } else if (String(input.ArtistName || '').trim()) {
      const existingIdx = findSingerByName_(singers, input.ArtistName);
      if (existingIdx >= 0) singer = singerFromRow_(singers, singers.rows[existingIdx]);
    } else {
      throw new Error('יש לבחור זמר או להקה.');
    }

    if (singer) {
      const key = songKey_(data.SongName, singer.SingerID);
      for (let i = 0; i < keys.n; i++) {
        const id = String(keys.data.SongID[i]);
        if (!id || id === String(input.SongID || '')) continue;
        if (songKey_(keys.data.SongName[i], String(keys.data.ArtistID[i])) === key && !opts.allowDuplicate) {
          const dup = locate_(SHEET.SONGS, 'SongID', id);
          return { status: 'duplicate', existing: songMeta_(songFromRow_(dup.t, dup.row)), singer };
        }
      }
    } else {
      const res = findOrCreateSinger_(singers, input.ArtistName);
      singer = res.singer;
      singerCreated = res.created;
    }

    const now = isoNow_();
    let rec;
    let joinsSinger = !input.SongID;
    if (input.SongID) {
      const loc = locate_(SHEET.SONGS, 'SongID', input.SongID);
      if (!loc) throw new Error('השיר לא נמצא (ייתכן שנמחק).');
      const before = songFromRow_(loc.t, loc.row);
      joinsSinger = String(before.ArtistID) !== String(singer.SingerID);
      rec = Object.assign({}, before, data, { ArtistID: singer.SingerID, UpdatedAt: now });
      updateObj_(loc.t, loc.idx, before, rec);
    } else {
      rec = Object.assign(data, {
        SongID: newId_('S'),
        ArtistID: singer.SingerID,
        DateAdded: now,
        LastPlayed: '',
        UpdatedAt: now,
      });
      appendObjs_(appendHandle_(keys.info, keys.n), [rec]);
    }
    const autoPlaylists = joinsSinger ? autoLinkSongs_([{ SongID: rec.SongID, ArtistID: singer.SingerID }], singers) : [];
    patchCache_((lib) => {
      upsertById_(lib.songs, 'SongID', songMeta_(rec));
      upsertById_(lib.singers, 'SingerID', singer);
      if (autoPlaylists.length) lib.playlists = readPlaylists_();
    });
    logHistory_(input.SongID ? 'update' : 'create', rec, singer.SingerName);
    return { status: 'saved', song: rec, singer, singerCreated, autoPlaylists };
  });
}

function updateSong_(id, patch) {
  return withLock_(() => {
    const loc = locate_(SHEET.SONGS, 'SongID', id);
    if (!loc) throw new Error('השיר לא נמצא.');
    const t = loc.t;
    const idx = loc.idx;
    const before = songFromRow_(t, loc.row);
    const rec = Object.assign({}, before);
    if ('IsFavorite' in patch) rec.IsFavorite = toBool_(patch.IsFavorite);
    if ('LearningStatus' in patch) rec.LearningStatus = toEnum_(patch.LearningStatus, ENUM.LearningStatus, before.LearningStatus);
    if ('Capo' in patch) rec.Capo = toInt_(patch.Capo, 0, 12, '');
    if ('PersonalNotes' in patch) rec.PersonalNotes = toText_(patch.PersonalNotes, 5000);
    if ('Hidden' in patch) rec.Hidden = toBool_(patch.Hidden);
    if ('ChordDirection' in patch) rec.ChordDirection = toEnum_(patch.ChordDirection, CHORD_DIRECTIONS, before.ChordDirection);
    if ('Transpose' in patch) {
      rec.Transpose = toInt_(patch.Transpose, -11, 11, 0);
      rec.PersonalKey = rec.OriginalKey ? ChordEngine.transposeKey(rec.OriginalKey, rec.Transpose) : rec.PersonalKey;
      if (!rec.Transpose && rec.OriginalKey) rec.PersonalKey = '';
    }
    rec.UpdatedAt = isoNow_();
    updateObj_(t, idx, before, rec);
    patchCache_((lib) => upsertById_(lib.songs, 'SongID', songMeta_(rec)));
    return songMeta_(rec);
  });
}

function deleteSong_(id) {
  return withLock_(() => {
    const refs = [SHEET.PRACTICE].reduce((n, name) => {
      const sh = ss_().getSheetByName(name);
      if (!sh) return n;
      const t = table_(name);
      return n + t.rows.filter((r) => String(r[t.col.SongID]) === String(id)).length;
    }, 0);
    if (refs) throw new Error(`לא ניתן למחוק: לשיר יש ${refs} רשומות תרגול.`);
    const t = table_(SHEET.SONGS);
    const idx = findIndex_(t, 'SongID', id);
    if (idx < 0) throw new Error('השיר לא נמצא.');
    const doomed = songFromRow_(t, t.rows[idx]);
    const singers = table_(SHEET.SINGERS);
    const si = findIndex_(singers, 'SingerID', doomed.ArtistID);
    logHistory_('delete', doomed, si >= 0 ? String(singers.rows[si][singers.col.SingerName]) : '');
    t.sh.deleteRow(idx + 2);
    const ps = table_(SHEET.PLAYLIST_SONGS);
    deleteRows_(ps, ps.rows.map((r, i) => (String(r[ps.col.SongID]) === String(id) ? i : -1)).filter((i) => i >= 0));
    invalidateCache_();
    return { deleted: id };
  });
}

// ------------------------------------------------------------------ integrity

/**
 * Makes rows typed directly into the sheet usable by the app: assigns missing IDs, resolves an
 * artist *name* typed into ArtistID to a singer (creating it if needed) and fills defaults.
 * Never deletes or overwrites user-entered values. Must run inside the lock.
 */
function repairData_() {
  const singers = table_(SHEET.SINGERS);
  const songs = table_(SHEET.SONGS, { skip: ['SongContent'] });
  const now = isoNow_();
  let fixed = 0;
  // Lyrics are read only when a row still needs its chord list computed (rows typed in the sheet).
  if (songs.rows.some((r) => String(r[songs.col.SongName]).trim() && !String(r[songs.col.ChordsUsed]).trim())) {
    const content = columns_(SHEET.SONGS, ['SongContent']).data.SongContent;
    songs.rows.forEach((r, i) => (r[songs.col.SongContent] = content[i]));
  }

  singers.rows.forEach((r, i) => {
    const s = singerFromRow_(singers, r);
    if (!s.SingerName.trim() || s.SingerID) return;
    const after = Object.assign({}, s, { SingerID: newId_('A'), DateAdded: s.DateAdded || now, UpdatedAt: now });
    updateObj_(singers, i, s, after);
    fixed++;
  });
  const ids = {};
  singers.rows.forEach((r) => (ids[String(r[singers.col.SingerID])] = true));

  const fresh = [];
  songs.rows.forEach((r, i) => {
    const s = songFromRow_(songs, r);
    if (!s.SongName.trim()) return;
    const after = Object.assign({}, s);
    if (!after.SongID) {
      after.SongID = newId_('S');
      fresh.push(after);
    }
    if (after.ArtistID && !ids[after.ArtistID]) {
      const res = findOrCreateSinger_(singers, after.ArtistID);
      after.ArtistID = res.singer.SingerID;
      ids[after.ArtistID] = true;
    }
    if (!after.LearningStatus) after.LearningStatus = 'Not Started';
    if (!after.DateAdded) after.DateAdded = now;
    if (!after.ChordsUsed && after.SongContent) after.ChordsUsed = ChordEngine.extractChords(after.SongContent).join(' ');
    const changed = updateObj_(songs, i, s, after);
    if (changed.length) fixed++;
  });
  if (fresh.length) autoLinkSongs_(fresh.map((x) => ({ SongID: x.SongID, ArtistID: x.ArtistID })), singers);
  return { fixed, songs, singers };
}

// ------------------------------------------------------------------ library + cache

function readLists_() {
  const t = table_(SHEET.LISTS);
  const lists = {};
  SCHEMA.Lists.forEach((name) => {
    const c = t.col[name];
    const vals = t.rows.map((r) => String(r[c]).trim()).filter(Boolean);
    lists[name] = vals.length ? vals : LIST_DEFAULTS[name].slice();
  });
  lists.LearningStatus = ENUM.LearningStatus.slice();
  lists.Difficulty = ENUM.Difficulty.slice();
  return lists;
}

function readSettings_() {
  const t = table_(SHEET.SETTINGS);
  const out = {};
  t.rows.forEach((r) => {
    const k = String(r[t.col.Key]).trim();
    if (k) out[k] = cellOut_(r[t.col.Value]);
  });
  return out;
}

function getLibrary_() {
  const cached = cacheGet_();
  if (cached) return overlayPlayed_(cached);
  if (!ss_().getSheetByName(SHEET.SONGS)) setup_();
  return withLock_(() => {
    snapshotIfUpgraded_(); // backup before this version writes anything
    const repaired = repairData_();
    seedPlaylists_();
    const songsT = repaired.songs;
    const singersT = repaired.singers;
    const lib = {
      app: { name: APP.NAME, version: APP.VERSION, schemaVersion: APP.SCHEMA_VERSION },
      spreadsheetUrl: ss_().getUrl(),
      // Lyrics are not read here (speed); a song with a chord list necessarily has content.
      songs: songsT.rows.map((r) => songFromRow_(songsT, r)).filter((s) => s.SongID && s.SongName).map((s) => Object.assign(songMeta_(s), { HasContent: !!(s.SongContent || s.ChordsUsed) })),
      singers: singersT.rows.map((r) => singerFromRow_(singersT, r)).filter((s) => s.SingerID && s.SingerName),
      lists: readLists_(),
      settings: readSettings_(),
      playlists: readPlaylists_(),
    };
    cachePut_(lib);
    return overlayPlayed_(lib);
  });
}

function upsertById_(list, idField, rec) {
  const i = list.findIndex((x) => x[idField] === rec[idField]);
  if (i >= 0) list[i] = rec;
  else list.push(rec);
}

function cacheKey_() {
  return APP.CACHE_KEY + '_' + APP.VERSION.replace(/\./g, '_');
}

function cacheGet_() {
  try {
    const cache = CacheService.getScriptCache();
    const n = parseInt(cache.get(cacheKey_()), 10);
    if (!n) return null;
    const keys = [];
    for (let i = 0; i < n; i++) keys.push(`${cacheKey_()}_${i}`);
    const parts = cache.getAll(keys);
    let json = '';
    for (const k of keys) {
      if (parts[k] === undefined || parts[k] === null) return null;
      json += parts[k];
    }
    return JSON.parse(json);
  } catch (e) {
    console.warn('cache read failed', e);
    return null;
  }
}

function cachePut_(lib) {
  try {
    const json = JSON.stringify(lib);
    const n = Math.ceil(json.length / APP.CACHE_CHUNK);
    if (n > 300) return invalidateCache_();
    const map = {};
    for (let i = 0; i < n; i++) map[`${cacheKey_()}_${i}`] = json.substr(i * APP.CACHE_CHUNK, APP.CACHE_CHUNK);
    const cache = CacheService.getScriptCache();
    cache.putAll(map, APP.CACHE_TTL_SEC);
    cache.put(cacheKey_(), String(n), APP.CACHE_TTL_SEC);
  } catch (e) {
    console.warn('cache write failed', e);
    invalidateCache_();
  }
}

function invalidateCache_() {
  try {
    CacheService.getScriptCache().remove(cacheKey_());
  } catch (e) {
    console.warn('cache invalidate failed', e);
  }
}

/** Applies `fn` to the cached library if one exists; on any error the cache is dropped. */
function patchCache_(fn) {
  const lib = cacheGet_();
  if (!lib) return;
  try {
    fn(lib);
    cachePut_(lib);
  } catch (e) {
    invalidateCache_();
  }
}

// ------------------------------------------------------------------ change history (append-only)

const HISTORY_SHEET = 'History';
const HISTORY_HEADERS = ['Timestamp', 'Action', 'SongID', 'SongName', 'ArtistName', 'Data'];

/**
 * Appends a full copy of the song to the History tab on every create / update / delete, so any
 * song can be recovered even after it was edited or deleted. Rows are only ever appended.
 * Must run inside the script lock. Never blocks the save itself.
 */
function logHistory_(action, song, artistName) {
  try {
    const ss = ss_();
    let sh = ss.getSheetByName(HISTORY_SHEET);
    if (!sh) {
      sh = ss.insertSheet(HISTORY_SHEET);
      sh.getRange(1, 1, 1, HISTORY_HEADERS.length).setValues([HISTORY_HEADERS]);
      sh.setFrozenRows(1);
    }
    // Append-only: read just the header row, never the (ever-growing) history itself.
    const info = sheetInfo_(HISTORY_SHEET);
    const t = appendHandle_(info, Math.max(0, sh.getLastRow() - 1));
    const missing = HISTORY_HEADERS.filter((h) => !(h in t.col));
    if (missing.length) throw new Error('History headers changed: ' + missing.join(','));
    const data = Object.assign({}, song, { ArtistName: artistName || '' });
    let json = JSON.stringify(data);
    if (json.length > 49000) json = JSON.stringify(Object.assign({}, data, { SongContent: '', ContentOmitted: true }));
    appendObjs_(t, [{ Timestamp: isoNow_(), Action: action, SongID: song.SongID, SongName: song.SongName, ArtistName: artistName || '', Data: json }], HISTORY_HEADERS);
  } catch (e) {
    console.warn('history log failed', e);
  }
}

/** Songs deleted and not restored since, newest first (from History). */
function listDeleted_() {
  const sh = ss_().getSheetByName(HISTORY_SHEET);
  if (!sh) return [];
  const t = table_(HISTORY_SHEET);
  const songs = table_(SHEET.SONGS);
  const alive = {};
  songs.rows.forEach((r) => (alive[String(r[songs.col.SongID])] = true));
  const out = [];
  const restored = {};
  for (let i = t.rows.length - 1; i >= 0 && out.length < 50; i--) {
    const r = t.rows[i];
    const action = String(r[t.col.Action]);
    if (action === 'restore') restored[String(r[t.col.SongID])] = true;
    if (action !== 'delete' || alive[String(r[t.col.SongID])] || restored[String(r[t.col.SongID])]) continue;
    out.push({ row: i, at: cellOut_(r[t.col.Timestamp]), SongID: String(r[t.col.SongID]), SongName: String(r[t.col.SongName]), ArtistName: String(r[t.col.ArtistName]) });
  }
  return out;
}

/** Re-creates a deleted song from its History copy (same content and personal data, new ID). */
function restoreDeleted_(row) {
  const t = table_(HISTORY_SHEET);
  const r = t.rows[Number(row)];
  if (!r || String(r[t.col.Action]) !== 'delete') throw new Error('רשומת ההיסטוריה לא נמצאה.');
  const data = JSON.parse(String(r[t.col.Data]));
  const res = saveSong_(Object.assign({}, data, { SongID: '', ArtistID: '', ArtistName: data.ArtistName || 'לא ידוע' }), { allowDuplicate: true });
  withLock_(() => logHistory_('restore', Object.assign({}, data, { SongID: String(r[t.col.SongID]) }), data.ArtistName));
  return res;
}


// ===== DriveBackup.gs =====
/**
 * Oren Song Book — JSON backups in Google Drive.
 *
 * The library lives in the spreadsheet, not in the script project, so replacing the script files
 * never touches it. On top of that, every song save / delete / restore / import writes a full JSON
 * backup to a Drive folder that is independent of both the script and the spreadsheet:
 *   <Slug>-v<version>-backup-latest.json      always the newest state
 *   <Slug>-v<version>-backup-YYYY-MM-DD.json  one per day (last 30 days kept; older ones go to Trash)
 * Small personal changes (favorite, status, notes) are throttled to one write per 2 minutes.
 * A failed Drive write never fails the save itself; the result reports it.
 */

const DRIVE_BACKUP = Object.freeze({
  FOLDER_NAME: 'Oren Song Book – גיבויים',
  FOLDER_PROP: 'BACKUP_FOLDER_ID',
  LAST_PROP: 'BACKUP_LAST_AT',
  DIRTY_PROP: 'BACKUP_DIRTY',
  KEEP_DAYS: 30,
  THROTTLE_MS: 2 * 60 * 1000,
});

function backupFolder_() {
  const props = PropertiesService.getScriptProperties();
  const id = props.getProperty(DRIVE_BACKUP.FOLDER_PROP);
  if (id) {
    try {
      const f = DriveApp.getFolderById(id);
      if (!f.isTrashed()) return f;
    } catch (e) {
      console.warn('backup folder id not usable, searching by name', e);
    }
  }
  const found = DriveApp.getFoldersByName(DRIVE_BACKUP.FOLDER_NAME);
  const folder = found.hasNext() ? found.next() : DriveApp.createFolder(DRIVE_BACKUP.FOLDER_NAME);
  props.setProperty(DRIVE_BACKUP.FOLDER_PROP, folder.getId());
  return folder;
}

function writeDriveFile_(folder, name, text) {
  const it = folder.getFilesByName(name);
  if (it.hasNext()) it.next().setContent(text);
  else folder.createFile(name, text, MimeType.PLAIN_TEXT);
}

/**
 * Writes the JSON backup. force=false applies the throttle (marks the backup as pending instead).
 * Returns {status:'ok'|'deferred'|'error', file?, folderUrl?, message?}.
 */
function driveBackup_(reason, force) {
  const props = PropertiesService.getScriptProperties();
  try {
    const last = Number(props.getProperty(DRIVE_BACKUP.LAST_PROP) || 0);
    if (!force && Date.now() - last < DRIVE_BACKUP.THROTTLE_MS) {
      props.setProperty(DRIVE_BACKUP.DIRTY_PROP, '1');
      return { status: 'deferred' };
    }
    const backup = exportBackup_();
    backup.reason = reason;
    const json = JSON.stringify(backup);
    const folder = backupFolder_();
    const prefix = `${APP.SLUG}-v${APP.VERSION}-backup-`;
    const daily = prefix + isoNow_().slice(0, 10) + '.json';
    writeDriveFile_(folder, prefix + 'latest.json', json);
    writeDriveFile_(folder, daily, json);
    pruneDriveBackups_(folder);
    props.setProperty(DRIVE_BACKUP.LAST_PROP, String(Date.now()));
    props.deleteProperty(DRIVE_BACKUP.DIRTY_PROP);
    return { status: 'ok', file: daily, folderUrl: folder.getUrl() };
  } catch (e) {
    console.warn('drive backup failed', e);
    const raw = String(e && e.message ? e.message : e);
    // The owner has not yet approved the Drive permission (new in 0.5.0): say how, plainly.
    const needsAuth = /permission|authoriz|הרשאה/i.test(raw);
    return {
      status: 'error',
      needsAuth,
      message: needsAuth
        ? 'צריך לאשר פעם אחת גישה ל-Google Drive: בעורך Apps Script בחר את הפונקציה setup ← ▶ Run ← אשר את ההרשאות, ואז Deploy ← New version.'
        : raw,
    };
  }
}

/** Moves daily backups older than KEEP_DAYS to Trash (recoverable for 30 days). Never touches other files. */
function pruneDriveBackups_(folder) {
  const re = new RegExp('^' + APP.SLUG + '-v[\\d.]+-backup-(\\d{4}-\\d{2}-\\d{2})\\.json$');
  const cutoff = new Date(Date.now() - DRIVE_BACKUP.KEEP_DAYS * 86400000).toISOString().slice(0, 10);
  const files = folder.getFiles();
  while (files.hasNext()) {
    const f = files.next();
    const m = re.exec(f.getName());
    if (m && m[1] < cutoff) f.setTrashed(true);
  }
}

function markBackupPending_(reason) {
  try {
    PropertiesService.getScriptProperties().setProperty(DRIVE_BACKUP.DIRTY_PROP, '1');
  } catch (e) {
    console.warn('pending mark failed', e);
  }
}

function driveBackupStatus_() {
  const props = PropertiesService.getScriptProperties();
  const last = Number(props.getProperty(DRIVE_BACKUP.LAST_PROP) || 0);
  const id = props.getProperty(DRIVE_BACKUP.FOLDER_PROP);
  return {
    lastAt: last ? new Date(last).toISOString() : '',
    pending: props.getProperty(DRIVE_BACKUP.DIRTY_PROP) === '1',
    folderUrl: id ? 'https://drive.google.com/drive/folders/' + id : '',
    folderName: DRIVE_BACKUP.FOLDER_NAME,
  };
}

/** Backup files in the Drive folder (also from older app names/versions), newest first. */
function listDriveBackups_() {
  const folder = backupFolder_();
  const out = [];
  const files = folder.getFiles();
  while (files.hasNext()) {
    const f = files.next();
    if (!/\.json$/i.test(f.getName())) continue;
    out.push({ id: f.getId(), name: f.getName(), updated: f.getLastUpdated().toISOString(), size: f.getSize() });
  }
  out.sort((a, b) => b.updated.localeCompare(a.updated));
  return out.slice(0, 60);
}

/** Merge-restores a Drive backup (adds only missing records, never overwrites). */
function restoreDriveBackup_(fileId) {
  const f = DriveApp.getFileById(String(fileId));
  const parents = f.getParents();
  const folderId = backupFolder_().getId();
  let inFolder = false;
  while (parents.hasNext()) if (parents.next().getId() === folderId) inFolder = true;
  if (!inFolder) throw new Error('הקובץ אינו בתיקיית הגיבויים.');
  return importBackup_(JSON.parse(f.getBlob().getDataAsString()));
}


// ===== Playlists.gs =====
/**
 * Oren Song Book — playlists.
 * Playlists (Playlists sheet) hold songs through PlaylistSongs (PlaylistID, SongID, Position).
 * A song can belong to any number of playlists. Hidden songs (Songs.Hidden) are left out of the
 * general lists and appear only inside the playlists they belong to.
 */

/** Created once, on the first run with playlists; deleting them later does not bring them back. */
function defaultPlaylists_() {
  return ['מזרחית', 'לועזי', 'ישראלי', 'שירים למדורה'];
}

function readPlaylists_() {
  const p = table_(SHEET.PLAYLISTS);
  const ps = table_(SHEET.PLAYLIST_SONGS);
  const list = p.rows
    .map((r) => rowObj_(p, r))
    .filter((o) => String(o.PlaylistID).trim())
    .map((o) => ({
      PlaylistID: String(o.PlaylistID),
      PlaylistName: String(o.PlaylistName),
      Description: String(o.Description || ''),
      SortOrder: Number(o.SortOrder) || 0,
      DateCreated: cellOut_(o.DateCreated),
      songs: [],
    }));
  const byId = {};
  list.forEach((x) => (byId[x.PlaylistID] = x));
  ps.rows
    .map((r) => rowObj_(ps, r))
    .filter((o) => byId[String(o.PlaylistID)] && String(o.SongID).trim())
    .sort((a, b) => (Number(a.Position) || 0) - (Number(b.Position) || 0))
    .forEach((o) => {
      const pl = byId[String(o.PlaylistID)];
      const sid = String(o.SongID);
      if (pl.songs.indexOf(sid) < 0) pl.songs.push(sid);
    });
  list.sort((a, b) => a.SortOrder - b.SortOrder || a.PlaylistName.localeCompare(b.PlaylistName, 'he'));
  return list;
}

/** Must run inside the lock. */
function seedPlaylists_() {
  const settings = table_(SHEET.SETTINGS);
  if (findIndex_(settings, 'Key', 'playlistsSeeded') >= 0) return;
  const p = table_(SHEET.PLAYLISTS);
  if (!p.rows.some((r) => String(r[p.col.PlaylistID]).trim())) {
    const now = isoNow_();
    appendObjs_(p, defaultPlaylists_().map((name, i) => ({ PlaylistID: newId_('P'), PlaylistName: name, Description: '', CoverImage: '', DateCreated: now, SortOrder: i + 1 })));
  }
  appendObjs_(settings, [{ Key: 'playlistsSeeded', Value: '1' }], ['Key', 'Value']);
}

function savePlaylist_(input) {
  const name = toText_(input.PlaylistName, 80).trim().replace(/\s+/g, ' ');
  if (!name) throw new Error('יש לתת שם לפלייליסט.');
  return withLock_(() => {
    const p = table_(SHEET.PLAYLISTS);
    const key = ChordEngine.normalizeName(name);
    const clash = p.rows.find((r) => ChordEngine.normalizeName(r[p.col.PlaylistName]) === key && String(r[p.col.PlaylistID]) !== String(input.PlaylistID || ''));
    if (clash) throw new Error(`כבר קיים פלייליסט בשם "${name}".`);
    let rec;
    if (input.PlaylistID) {
      const idx = findIndex_(p, 'PlaylistID', input.PlaylistID);
      if (idx < 0) throw new Error('הפלייליסט לא נמצא.');
      const before = rowObj_(p, p.rows[idx]);
      rec = Object.assign({}, before, { PlaylistName: name, Description: toText_(input.Description, 300) });
      updateObj_(p, idx, before, rec);
    } else {
      const max = p.rows.reduce((m, r) => Math.max(m, Number(r[p.col.SortOrder]) || 0), 0);
      rec = { PlaylistID: newId_('P'), PlaylistName: name, Description: toText_(input.Description, 300), CoverImage: '', DateCreated: isoNow_(), SortOrder: max + 1 };
      appendObjs_(p, [rec]);
    }
    patchCache_((lib) => (lib.playlists = readPlaylists_()));
    return { PlaylistID: String(rec.PlaylistID), PlaylistName: name };
  });
}

/** Deletes rows (0-based data indices) bottom-up so indices stay valid. */
function deleteRows_(t, indices) {
  indices.sort((a, b) => b - a).forEach((i) => t.sh.deleteRow(i + 2));
}

/** Deletes the playlist and its song links. The songs themselves are not touched. */
function deletePlaylist_(id) {
  return withLock_(() => {
    const p = table_(SHEET.PLAYLISTS);
    const idx = findIndex_(p, 'PlaylistID', id);
    if (idx < 0) throw new Error('הפלייליסט לא נמצא.');
    const ps = table_(SHEET.PLAYLIST_SONGS);
    deleteRows_(ps, ps.rows.map((r, i) => (String(r[ps.col.PlaylistID]) === String(id) ? i : -1)).filter((i) => i >= 0));
    p.sh.deleteRow(idx + 2);
    // Singers linked to this playlist stop pointing at it.
    const singers = table_(SHEET.SINGERS);
    const touched = [];
    singers.rows.forEach((r, i) => {
      const ids = splitIds_(r[singers.col.AutoPlaylists]);
      if (ids.indexOf(String(id)) < 0) return;
      const before = singerFromRow_(singers, r);
      const after = Object.assign({}, before, { AutoPlaylists: ids.filter((x) => x !== String(id)).join(' ') });
      updateObj_(singers, i, before, after);
      touched.push(after);
    });
    patchCache_((lib) => {
      lib.playlists = readPlaylists_();
      touched.forEach((a) => upsertById_(lib.singers, 'SingerID', a));
    });
    return { deleted: id };
  });
}

/** Sets exactly which playlists a song belongs to (adds and removes links). */
function setSongPlaylists_(songId, playlistIds) {
  const want = Array.from(new Set((playlistIds || []).map(String)));
  return withLock_(() => {
    if (columns_(SHEET.SONGS, ['SongID']).data.SongID.map(String).indexOf(String(songId)) < 0) throw new Error('השיר לא נמצא.');
    const p = table_(SHEET.PLAYLISTS);
    const known = {};
    p.rows.forEach((r) => (known[String(r[p.col.PlaylistID])] = true));
    const ps = table_(SHEET.PLAYLIST_SONGS);
    const has = {};
    const drop = [];
    ps.rows.forEach((r, i) => {
      if (String(r[ps.col.SongID]) !== String(songId)) return;
      const pid = String(r[ps.col.PlaylistID]);
      if (want.indexOf(pid) < 0 || has[pid]) drop.push(i);
      else has[pid] = true;
    });
    const now = isoNow_();
    const add = want.filter((pid) => known[pid] && !has[pid]).map((pid) => {
      const last = ps.rows.reduce((m, r) => (String(r[ps.col.PlaylistID]) === pid ? Math.max(m, Number(r[ps.col.Position]) || 0) : m), 0);
      return { PlaylistID: pid, SongID: String(songId), Position: last + 1, DateAdded: now };
    });
    if (add.length) appendObjs_(ps, add);
    deleteRows_(ps, drop);
    patchCache_((lib) => (lib.playlists = readPlaylists_()));
    return { SongID: String(songId), playlists: want.filter((pid) => known[pid]) };
  });
}

/** Saves the order of songs inside a playlist. */
function reorderPlaylist_(id, songIds) {
  const order = (songIds || []).map(String);
  return withLock_(() => {
    const ps = table_(SHEET.PLAYLIST_SONGS);
    ps.rows.forEach((r, i) => {
      if (String(r[ps.col.PlaylistID]) !== String(id)) return;
      const pos = order.indexOf(String(r[ps.col.SongID]));
      const value = pos >= 0 ? pos + 1 : order.length + 1;
      if (Number(r[ps.col.Position]) !== value) writeBlock_(ps, i, [{ Position: value }], ['Position']);
    });
    patchCache_((lib) => (lib.playlists = readPlaylists_()));
    return { PlaylistID: String(id), songs: order };
  });
}

const knownPlaylists_ = () => {
  const p = table_(SHEET.PLAYLISTS);
  const known = {};
  p.rows.forEach((r) => (known[String(r[p.col.PlaylistID])] = true));
  return known;
};

/** Appends playlist links that do not exist yet ({PlaylistID, SongID} pairs). Returns how many were added. */
function appendLinks_(pairs) {
  if (!pairs.length) return 0;
  const ps = table_(SHEET.PLAYLIST_SONGS);
  const linked = {};
  const lastPos = {};
  ps.rows.forEach((r) => {
    const pid = String(r[ps.col.PlaylistID]);
    linked[pid + '|' + String(r[ps.col.SongID])] = true;
    lastPos[pid] = Math.max(lastPos[pid] || 0, Number(r[ps.col.Position]) || 0);
  });
  const now = isoNow_();
  const add = [];
  pairs.forEach(({ PlaylistID: pid, SongID: sid }) => {
    if (linked[pid + '|' + sid]) return;
    linked[pid + '|' + sid] = true;
    lastPos[pid] = (lastPos[pid] || 0) + 1;
    add.push({ PlaylistID: pid, SongID: sid, Position: lastPos[pid], DateAdded: now });
  });
  if (add.length) appendObjs_(ps, add);
  return add.length;
}

const splitIds_ = (v) => String(v || '').split(/[\s,]+/).filter(Boolean);

/**
 * New songs of a singer join the playlists linked to that singer (Singers.AutoPlaylists).
 * Must run inside the lock. Returns the playlist IDs a song was added to.
 */
function autoLinkSongs_(songs, singersT) {
  const auto = {};
  singersT.rows.forEach((r) => {
    const ids = splitIds_(r[singersT.col.AutoPlaylists]);
    if (ids.length) auto[String(r[singersT.col.SingerID])] = ids;
  });
  const pairs = [];
  songs.forEach((s) => (auto[String(s.ArtistID)] || []).forEach((pid) => pairs.push({ PlaylistID: pid, SongID: String(s.SongID) })));
  if (!pairs.length) return [];
  const known = knownPlaylists_();
  const valid = pairs.filter((x) => known[x.PlaylistID]);
  appendLinks_(valid);
  return Array.from(new Set(valid.map((x) => x.PlaylistID)));
}

/**
 * Adds many songs (e.g. all of a singer's songs) to one or more playlists in one go; keeps existing links.
 * opts.linkSingerIds (or linkSingerId): also link those singers to these playlists, so their future songs join too.
 */
function addSongsToPlaylists_(songIds, playlistIds, opts) {
  const songs = Array.from(new Set((songIds || []).map(String)));
  const pls = Array.from(new Set((playlistIds || []).map(String)));
  const o = opts || {};
  const linkSingers = Array.from(new Set((Array.isArray(o.linkSingerIds) ? o.linkSingerIds : []).concat(o.linkSingerId ? [o.linkSingerId] : []).map(String)));
  return withLock_(() => {
    const known = knownPlaylists_();
    const existing = {};
    columns_(SHEET.SONGS, ['SongID']).data.SongID.forEach((id) => (existing[String(id)] = true));
    const pairs = [];
    pls.filter((pid) => known[pid]).forEach((pid) => songs.filter((sid) => existing[sid]).forEach((sid) => pairs.push({ PlaylistID: pid, SongID: sid })));
    const added = appendLinks_(pairs);
    const linked = [];
    if (linkSingers.length) {
      const t = table_(SHEET.SINGERS);
      const idxs = linkSingers.map((sid) => findIndex_(t, 'SingerID', sid));
      if (idxs.some((i) => i < 0)) throw new Error('אחד הזמרים לא נמצא (ייתכן שנמחק).');
      const now = isoNow_();
      idxs.forEach((idx) => {
        const before = singerFromRow_(t, t.rows[idx]);
        const ids = splitIds_(before.AutoPlaylists).filter((pid) => known[pid]);
        pls.filter((pid) => known[pid] && ids.indexOf(pid) < 0).forEach((pid) => ids.push(pid));
        const after = Object.assign({}, before, { AutoPlaylists: ids.join(' '), UpdatedAt: now });
        updateObj_(t, idx, before, after);
        linked.push(after);
      });
    }
    patchCache_((lib) => {
      lib.playlists = readPlaylists_();
      linked.forEach((a) => upsertById_(lib.singers, 'SingerID', a));
    });
    return { added, singer: linked.length === 1 ? linked[0] : null, singers: linked };
  });
}

/** Sets which playlists a singer's future songs join (unlinking never removes songs already added). */
function setSingerAutoPlaylists_(singerId, playlistIds) {
  return withLock_(() => {
    const known = knownPlaylists_();
    const t = table_(SHEET.SINGERS);
    const idx = findIndex_(t, 'SingerID', singerId);
    if (idx < 0) throw new Error('הזמר לא נמצא.');
    const before = singerFromRow_(t, t.rows[idx]);
    const ids = Array.from(new Set((playlistIds || []).map(String))).filter((pid) => known[pid]);
    const rec = Object.assign({}, before, { AutoPlaylists: ids.join(' '), UpdatedAt: isoNow_() });
    updateObj_(t, idx, before, rec);
    patchCache_((lib) => upsertById_(lib.singers, 'SingerID', rec));
    return rec;
  });
}


// ===== Projector.gs =====
/**
 * Oren Song Book — projector remote channel.
 *
 * The TV (projector mode) and a phone (remote) talk through CacheService, keyed by a short
 * session code shown on the TV. The TV long-polls for commands (one call waits up to ~20s and
 * returns as soon as a command arrives); the phone sends commands and reads the TV's state.
 * Only display commands exist — nothing here can change the library — so viewers may use it too.
 * Sessions expire after 6 hours of inactivity.
 */

const PROJ = Object.freeze({
  TTL_SEC: 21600,
  POLL_MS: 20000,
  POLL_STEP_MS: 350,
  CODE_RE: /^[A-HJ-NP-Z2-9]{5}$/,
  COMMANDS: ['next', 'prev', 'toggle', 'play', 'pause', 'speed+', 'speed-', 'font+', 'font-', 'font0', 'tr+', 'tr-', 'tr0', 'theme', 'top', 'lyrics'],
  MAX_STATE: 2000,
});

function projKey_(code, part) {
  return 'proj_' + code + '_' + part;
}

function projCode_(code) {
  const c = String(code || '').trim().toUpperCase();
  if (!PROJ.CODE_RE.test(c)) throw new Error('קוד שלט לא תקין.');
  return c;
}

/** The TV opens (or re-opens) a session. */
function projOpen_(code) {
  const c = projCode_(code);
  const cache = CacheService.getScriptCache();
  if (!cache.get(projKey_(c, 'seq'))) cache.put(projKey_(c, 'seq'), '0', PROJ.TTL_SEC);
  return { code: c, seq: Number(cache.get(projKey_(c, 'seq'))) || 0 };
}

/** The phone sends one command; returns the TV's last published state. */
function projCommand_(code, cmd) {
  const c = projCode_(code);
  const type = String(cmd && cmd.type);
  if (PROJ.COMMANDS.indexOf(type) < 0) throw new Error('פקודה לא מוכרת.');
  const cache = CacheService.getScriptCache();
  const lock = LockService.getScriptLock();
  lock.waitLock(10000);
  try {
    const cur = cache.get(projKey_(c, 'seq'));
    if (cur === null) throw new Error('לא נמצא מסך מקרן עם הקוד הזה. ודא שמצב המקרן פתוח בטלוויזיה.');
    const seq = (Number(cur) || 0) + 1;
    cache.put(projKey_(c, 'cmd_' + seq), JSON.stringify({ type, at: Date.now() }), PROJ.TTL_SEC);
    cache.put(projKey_(c, 'seq'), String(seq), PROJ.TTL_SEC);
  } finally {
    lock.releaseLock();
  }
  return projGetState_(c);
}

/** The TV waits for commands newer than `after`. */
function projPoll_(code, after, waitMs) {
  const c = projCode_(code);
  const cache = CacheService.getScriptCache();
  const since = Number(after) || 0;
  const wait = waitMs === undefined || waitMs === null ? PROJ.POLL_MS : Math.max(0, Number(waitMs) || 0);
  const deadline = Date.now() + Math.min(PROJ.POLL_MS, wait);
  for (;;) {
    const seq = Number(cache.get(projKey_(c, 'seq'))) || 0;
    if (seq > since) {
      const keys = [];
      for (let i = Math.max(since + 1, seq - 20); i <= seq; i++) keys.push(projKey_(c, 'cmd_' + i));
      const got = cache.getAll(keys);
      const cmds = keys.map((k) => got[k]).filter(Boolean).map((t) => JSON.parse(t));
      cache.put(projKey_(c, 'seq'), String(seq), PROJ.TTL_SEC); // keep the session alive
      return { seq, cmds };
    }
    if (Date.now() + PROJ.POLL_STEP_MS > deadline) return { seq, cmds: [] };
    Utilities.sleep(PROJ.POLL_STEP_MS);
  }
}

/** The TV publishes what it shows (song, speed, font…) for the phone to display. */
function projSetState_(code, state) {
  const c = projCode_(code);
  const text = JSON.stringify(state || {});
  if (text.length > PROJ.MAX_STATE) throw new Error('state too large');
  CacheService.getScriptCache().put(projKey_(c, 'state'), text, PROJ.TTL_SEC);
  return true;
}

function projGetState_(code) {
  const c = projCode_(code);
  const cache = CacheService.getScriptCache();
  const t = cache.get(projKey_(c, 'state'));
  return { connected: cache.get(projKey_(c, 'seq')) !== null, state: t ? JSON.parse(t) : null };
}


// ===== Setup.gs =====
/**
 * Guitar Studio — idempotent database setup / schema upgrade.
 * Creates missing sheets and appends missing header columns. Never deletes or reorders
 * existing columns or data, and refuses to touch a same-named sheet with foreign content.
 */

function setup_() {
  return withLock_(() => {
    const ss = ss_();
    const report = [];
    const backups = snapshotIfUpgraded_();
    if (backups) report.push(`נוצר גיבוי לפני העדכון: ${backups.join(', ')}`);
    Object.keys(SCHEMA).forEach((name) => ensureSheet_(ss, name, SCHEMA[name], report));
    seedLists_(ss);
    ensureSettings_();
    formatSheets_(ss);
    buildLibraryView_(ss);
    invalidateCache_();
    return report;
  });
}

function ensureSheet_(ss, name, headers, report) {
  let sh = ss.getSheetByName(name);
  if (!sh) {
    sh = ss.insertSheet(name);
    ensureColumns_(sh, headers.length);
    sh.getRange(1, 1, 1, headers.length).setValues([headers]);
    report.push(`נוצרה לשונית ${name}`);
    return;
  }
  const lastCol = sh.getLastColumn();
  const existing = lastCol ? sh.getRange(1, 1, 1, lastCol).getValues()[0].map((h) => String(h).trim()) : [];
  const known = headers.filter((h) => existing.indexOf(h) >= 0);
  if (!known.length && sh.getLastRow() > 0) {
    throw new Error(`הלשונית "${name}" קיימת ומכילה נתונים במבנה אחר. שנה את שמה והפעל שוב את ההקמה.`);
  }
  const missing = headers.filter((h) => existing.indexOf(h) < 0);
  if (!missing.length) return;
  ensureColumns_(sh, lastCol + missing.length);
  sh.getRange(1, lastCol + 1, 1, missing.length).setValues([missing]);
  report.push(`${name}: נוספו עמודות ${missing.join(', ')}`);
}

function ensureColumns_(sh, needed) {
  const max = sh.getMaxColumns();
  if (needed > max) sh.insertColumnsAfter(max, needed - max);
}

/** Fills default values only into empty list columns, so user edits are kept. */
function seedLists_() {
  const t = table_(SHEET.LISTS);
  SCHEMA.Lists.forEach((name) => {
    const c = t.col[name];
    if (t.rows.some((r) => String(r[c]).trim())) return;
    const vals = LIST_DEFAULTS[name];
    ensureCapacity_(t.sh, vals.length + 1);
    t.sh.getRange(2, c + 1, vals.length, 1).setValues(vals.map((v) => [v]));
  });
}

function ensureSettings_() {
  const t = table_(SHEET.SETTINGS);
  const have = {};
  t.rows.forEach((r) => (have[String(r[t.col.Key])] = true));
  const now = isoNow_();
  const wanted = [
    { Key: 'appName', Value: APP.NAME },
    { Key: 'schemaVersion', Value: APP.SCHEMA_VERSION },
    { Key: 'createdAt', Value: now },
  ].filter((s) => !have[s.Key]);
  if (wanted.length) appendObjs_(t, wanted, ['Key', 'Value']);
  const idx = findIndex_(t, 'Key', 'appVersion');
  if (idx < 0) appendObjs_(t, [{ Key: 'appVersion', Value: APP.VERSION }], ['Key', 'Value']);
  else writeBlock_(t, idx, [{ Value: APP.VERSION }], ['Value']);
}

function formatSheets_(ss) {
  Object.keys(SCHEMA).forEach((name) => {
    const sh = ss.getSheetByName(name);
    const lastCol = sh.getLastColumn();
    sh.setFrozenRows(1);
    sh.getRange(1, 1, 1, lastCol).setFontWeight('bold').setBackground('#1f2229').setFontColor('#d4af37');
  });
  const songs = table_(SHEET.SONGS);
  const lists = table_(SHEET.LISTS);
  const rows = Math.max(1, songs.sh.getMaxRows() - 1);
  [
    ['LearningStatus', 'LearningStatus'],
    ['Difficulty', 'Difficulty'],
    ['PlayingStyle', 'PlayingStyle'],
    ['Tuning', 'Tuning'],
    ['Language', 'Language'],
    ['GuitarPreference', 'GuitarPreference'],
  ].forEach(([field, list]) => {
    const letter = columnLetter_(lists.col[list] + 1);
    const rule = SpreadsheetApp.newDataValidation()
      .requireValueInRange(lists.sh.getRange(`${letter}2:${letter}`), true)
      .setAllowInvalid(true)
      .build();
    songs.sh.getRange(2, songs.col[field] + 1, rows, 1).setDataValidation(rule);
  });
  songs.sh.setColumnWidth(songs.col.SongContent + 1, 320);
}

/** A read-only, auto-updating view of all songs sorted by artist then song name. */
function buildLibraryView_(ss) {
  const songs = table_(SHEET.SONGS);
  const singers = table_(SHEET.SINGERS);
  let sh = ss.getSheetByName(APP.LIBRARY_VIEW);
  if (!sh) sh = ss.insertSheet(APP.LIBRARY_VIEW);
  const S = (f) => `Songs!${columnLetter_(songs.col[f] + 1)}2:${columnLetter_(songs.col[f] + 1)}`;
  const A = (f) => `Singers!${columnLetter_(singers.col[f] + 1)}2:${columnLetter_(singers.col[f] + 1)}`;
  const headers = ['אמן', 'שיר', 'סולם מקורי', 'סולם אישי', 'קאפו', 'אקורדים', 'מועדף', 'סטטוס', 'מזהה שיר'];
  const formula =
    `=ARRAYFORMULA(IFERROR(SORT(FILTER({IFERROR(VLOOKUP(${S('ArtistID')},{${A('SingerID')},${A('SingerName')}},2,FALSE),""),` +
    `${S('SongName')},${S('OriginalKey')},${S('PersonalKey')},${S('Capo')},${S('ChordsUsed')},` +
    `${S('IsFavorite')},${S('LearningStatus')},${S('SongID')}},${S('SongID')}<>""),1,TRUE,2,TRUE),""))`;
  sh.getRange(1, 1, 1, headers.length).setValues([headers]).setFontWeight('bold');
  sh.getRange(2, 1).setFormula(formula);
  sh.setFrozenRows(1);
  sh.setRightToLeft(true);
}

function columnLetter_(n) {
  let s = '';
  while (n > 0) {
    const m = (n - 1) % 26;
    s = String.fromCharCode(65 + m) + s;
    n = Math.floor((n - 1) / 26);
  }
  return s;
}

// ------------------------------------------------------------------ safety snapshots

const SNAPSHOT_KEEP = 5;
const SNAPSHOT_RE = /^גיבוי (Songs|Singers) \d{4}-\d{2}-\d{2} \d{2}:\d{2}(:\d{2})?$/;

/**
 * Runs before any write of a newly deployed version: if the version recorded in Settings differs
 * from this code's version, copies Songs and Singers to dated backup tabs, then records the new
 * version. Must run inside the script lock. Returns the backup tab names, or null.
 */
function snapshotIfUpgraded_() {
  const ss = ss_();
  if (!ss.getSheetByName(SHEET.SETTINGS) || !ss.getSheetByName(SHEET.SONGS)) return null;
  const t = table_(SHEET.SETTINGS);
  const idx = findIndex_(t, 'Key', 'appVersion');
  const from = idx >= 0 ? String(t.rows[idx][t.col.Value]).trim() : '';
  if (from === APP.VERSION) return null;
  const made = snapshot_();
  Object.keys(SCHEMA).forEach((name) => ensureSheet_(ss, name, SCHEMA[name], []));
  const sv = findIndex_(t, 'Key', 'schemaVersion');
  if (sv >= 0) writeBlock_(t, sv, [{ Value: APP.SCHEMA_VERSION }], ['Value']);
  if (idx >= 0) writeBlock_(t, idx, [{ Value: APP.VERSION }], ['Value']);
  else appendObjs_(t, [{ Key: 'appVersion', Value: APP.VERSION }], ['Key', 'Value']);
  return made.length ? made : null;
}

/** Copies Songs and Singers (with all their columns) to dated tabs; keeps the newest SNAPSHOT_KEEP of each. */
function snapshot_() {
  const ss = ss_();
  let stamp = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd HH:mm');
  const made = [];
  [SHEET.SONGS, SHEET.SINGERS].forEach((name) => {
    const sh = ss.getSheetByName(name);
    if (!sh || sh.getLastRow() < 2) return;
    let title = `גיבוי ${name} ${stamp}`;
    if (ss.getSheetByName(title)) title = `גיבוי ${name} ${Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd HH:mm:ss')}`;
    if (ss.getSheetByName(title)) return;
    const copy = sh.copyTo(ss).setName(title);
    copy.setTabColor('#777777');
    made.push(title);
  });
  pruneSnapshots_();
  return made;
}

/** Deletes only automatic backup tabs (exact name pattern), oldest first, beyond SNAPSHOT_KEEP per sheet. */
function pruneSnapshots_() {
  const ss = ss_();
  [SHEET.SONGS, SHEET.SINGERS].forEach((name) => {
    const tabs = ss.getSheets().filter((sh) => SNAPSHOT_RE.test(sh.getName()) && sh.getName().indexOf(`גיבוי ${name} `) === 0);
    tabs.sort((a, b) => a.getName().localeCompare(b.getName()));
    tabs.slice(0, Math.max(0, tabs.length - SNAPSHOT_KEEP)).forEach((sh) => ss.deleteSheet(sh));
  });
}


// ===== Visits.gs =====
/**
 * Oren Song Book — visitor log (owner only).
 * Viewers (anyone who is not the owner) report what they open, in small batches. Each row:
 * time, an anonymous device id, the name the visitor chose to give (optional), device, event.
 * Google does not give the visitor's account or IP to a public web app, so nothing else is known.
 * The owner's own visits are never logged. Rows older than VISITS.KEEP_DAYS are removed.
 */

const VISITS = Object.freeze({
  SHEET: 'Visits',
  HEADERS: ['Time', 'VisitorID', 'Name', 'Device', 'Session', 'Event', 'Detail'],
  KEEP_DAYS: 90,
  MAX_EVENTS: 40,
  EVENTS: ['open', 'name', 'song', 'playlist', 'singer', 'perf', 'projector', 'chords', 'view'],
});

function visitsSheet_() {
  const ss = ss_();
  let sh = ss.getSheetByName(VISITS.SHEET);
  if (!sh) {
    sh = ss.insertSheet(VISITS.SHEET);
    sh.getRange(1, 1, 1, VISITS.HEADERS.length).setValues([VISITS.HEADERS]);
    sh.setFrozenRows(1);
  }
  return sh;
}

const visitText_ = (v, n) => String(v === null || v === undefined ? '' : v).replace(/[\u0000-\u001f]/g, ' ').trim().slice(0, n);

/** Appends a viewer's events (append-only: the log itself is never read here). */
function logVisits_(visitor, events) {
  const id = visitText_(visitor && visitor.id, 40).replace(/[^\w-]/g, '');
  if (!id) return { logged: 0 };
  const name = visitText_(visitor.name, 40);
  const device = visitText_(visitor.device, 60);
  const session = visitText_(visitor.session, 20).replace(/[^\w-]/g, '');
  const list = (Array.isArray(events) ? events : []).slice(0, VISITS.MAX_EVENTS)
    .filter((e) => e && VISITS.EVENTS.indexOf(String(e.ev)) >= 0);
  if (!list.length) return { logged: 0 };
  const now = Date.now();
  const rows = list.map((e) => {
    const t = Number(e.t);
    const at = t && Math.abs(now - t) < 3 * 86400000 ? new Date(t) : new Date(now);
    return { Time: at.toISOString(), VisitorID: id, Name: name, Device: device, Session: session, Event: String(e.ev), Detail: visitText_(e.d, 120) };
  });
  return withLock_(() => {
    const sh = visitsSheet_();
    const info = sheetInfo_(VISITS.SHEET);
    appendObjs_(appendHandle_(info, Math.max(0, sh.getLastRow() - 1)), rows, VISITS.HEADERS);
    return { logged: rows.length };
  });
}

/** For the owner: recent events, one line per visitor, most viewed songs. Old rows are pruned here. */
function readVisits_() {
  const sh = ss_().getSheetByName(VISITS.SHEET);
  if (!sh || sh.getLastRow() < 2) return { visitors: [], events: [], topSongs: [], keepDays: VISITS.KEEP_DAYS };
  const t = table_(VISITS.SHEET);
  const cutoff = new Date(Date.now() - VISITS.KEEP_DAYS * 86400000).toISOString();
  const rows = t.rows.map((r) => rowObj_(t, r)).map((o) => Object.assign(o, { Time: cellOut_(o.Time) ? String(cellOut_(o.Time)) : '' }));
  // Rows are appended in time order: the old ones are at the top.
  let old = 0;
  while (old < rows.length && rows[old].Time && rows[old].Time < cutoff) old++;
  if (old) withLock_(() => sh.deleteRows(2, old));
  const live = rows.slice(old);
  const by = {};
  const songs = {};
  live.forEach((o) => {
    const v = by[o.VisitorID] || (by[o.VisitorID] = { id: String(o.VisitorID), name: '', device: '', first: o.Time, last: o.Time, sessions: {}, songs: {} });
    if (o.Name) v.name = String(o.Name);
    if (o.Device) v.device = String(o.Device);
    if (o.Time < v.first) v.first = o.Time;
    if (o.Time > v.last) v.last = o.Time;
    if (o.Session) v.sessions[o.Session] = true;
    if (o.Event === 'song' && o.Detail) { v.songs[o.Detail] = (v.songs[o.Detail] || 0) + 1; songs[o.Detail] = (songs[o.Detail] || 0) + 1; }
  });
  const visitors = Object.keys(by).map((k) => {
    const v = by[k];
    return { id: v.id, name: v.name, device: v.device, first: v.first, last: v.last, visits: Object.keys(v.sessions).length || 1,
      songs: Object.keys(v.songs).sort((a, b) => v.songs[b] - v.songs[a]).slice(0, 12) };
  }).sort((a, b) => b.last.localeCompare(a.last));
  const names = {};
  visitors.forEach((v) => (names[v.id] = v.name));
  const events = live.slice(-300).reverse().map((o) => ({ time: o.Time, id: String(o.VisitorID), name: names[o.VisitorID] || String(o.Name || ''), device: String(o.Device || ''), ev: String(o.Event), detail: String(o.Detail || '') }));
  const topSongs = Object.keys(songs).sort((a, b) => songs[b] - songs[a]).slice(0, 10).map((s) => ({ song: s, count: songs[s] }));
  return { visitors, events, topSongs, keepDays: VISITS.KEEP_DAYS };
}

