  const CATEGORIES = [
    { id: 'basic', he: 'בסיסי', list: ['', 'm', '7', 'maj7', 'm7', 'sus2', 'sus4'] },
    { id: 'sev', he: 'ספטימות ושישיות', list: ['6', 'm6', '7sus4', 'm7b5', 'dim7', 'mMaj7'] },
    { id: 'ext', he: 'מורחבים', list: ['add9', 'madd9', '9', 'maj9', 'm9', '11', '13'] },
    { id: 'alt', he: 'מיוחדים', list: ['dim', 'aug', '7b9', '7#9'] },
  ];
  const categoryOf = (suffix) => (CATEGORIES.find((c) => c.list.indexOf(suffix) >= 0) || CATEGORIES[0]).id;

  /** The seven chords of the chord's key (major, or natural minor for minor chords), with roman numerals. */
  function diatonic(ch) {
    const minor = /^m(?!aj)/.test(ch.suffix);
    const steps = minor ? [0, 2, 3, 5, 7, 8, 10] : [0, 2, 4, 5, 7, 9, 11];
    const kinds = minor ? ['m', 'dim', '', 'm', 'm', '', ''] : ['', 'm', 'm', '', '', 'm', 'dim'];
    const romans = minor ? ['i', 'ii°', 'III', 'iv', 'v', 'VI', 'VII'] : ['I', 'ii', 'iii', 'IV', 'V', 'vi', 'vii°'];
    const flats = CE.preferFlatsForKey(ch.root + (minor ? 'm' : '')) || /b/.test(ch.root);
    return steps.map((st, i) => ({ chord: noteName(ch.rootPc + st, flats) + kinds[i], roman: romans[i] }));
  }

  /** Chord moved by semitones (bass and type kept). */
  function shift(ch, semis) {
    const flats = /b/.test(ch.root) || (semis < 0 && !/#/.test(ch.root));
    return parse(noteName(ch.rootPc + semis, flats) + ch.suffix + (ch.bass ? '/' + noteName(ch.bassPc + semis, flats) : ''));
  }

  const theory = { CATEGORIES, categoryOf, diatonic, shift, ROOTS, QUALITIES, TUNINGS, SCALES, parse, describe, voicings, fingersFor, neckMap, libraryChords, tuningById, degClass, transpose: (sym, semis) => CE.transposeChord(sym, semis, false) };

  // ================================================================ audio (synthesised plucked string; lazy)

  const A = { ctx: null, out: null, cache: new Map() };
  function audio() {
    if (A.ctx) return A;
    const AC = window.AudioContext || window.webkitAudioContext;
    if (!AC) return null;
    const ctx = new AC();
    const master = ctx.createGain();
    master.gain.value = 0.55;
    // Warm body: gentle low-mid lift, soft top, short room.
    const body = ctx.createBiquadFilter();
    body.type = 'peaking'; body.frequency.value = 110; body.Q.value = 0.9; body.gain.value = 5;
    const body2 = ctx.createBiquadFilter();
    body2.type = 'peaking'; body2.frequency.value = 220; body2.Q.value = 1.1; body2.gain.value = 2.5;
    const soft = ctx.createBiquadFilter();
    soft.type = 'lowpass'; soft.frequency.value = 3600; soft.Q.value = 0.5;
    const room = ctx.createConvolver();
    const len = Math.floor(ctx.sampleRate * 1.4);
    const ir = ctx.createBuffer(2, len, ctx.sampleRate);
    for (let c = 0; c < 2; c++) { const d = ir.getChannelData(c); for (let i = 0; i < len; i++) d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / len, 3.2) * 0.5; }
    room.buffer = ir;
    const wet = ctx.createGain();
    wet.gain.value = 0.16;
    master.connect(body); body.connect(body2); body2.connect(soft); soft.connect(ctx.destination);
    soft.connect(room); room.connect(wet); wet.connect(ctx.destination);
    A.ctx = ctx; A.out = master;
    return A;
  }

  /** Karplus–Strong plucked string (no recorded samples): warm, long sustain for low notes. */
  function pluckBuffer(midi) {
    if (A.cache.has(midi)) return A.cache.get(midi);
    const ctx = A.ctx;
    const sr = ctx.sampleRate;
    const f = 440 * Math.pow(2, (midi - 69) / 12);
    const N = Math.max(2, Math.round(sr / f));
    const T = midi < 50 ? 4.2 : midi < 60 ? 3.4 : 2.6;
    const dur = T * 0.9;
    const len = Math.floor(sr * dur);
    const buf = ctx.createBuffer(1, len, sr);
    const d = buf.getChannelData(0);
    const ring = new Float32Array(N);
    let prev = 0;
    for (let i = 0; i < N; i++) { const r = Math.random() * 2 - 1; prev = prev * 0.55 + r * 0.45; ring[i] = prev; } // pre-filtered noise: rounder attack
    const g = Math.pow(0.001, 1 / (f * T));
    let k = 0;
    for (let i = 0; i < len; i++) {
      const a = ring[k];
      const b = ring[(k + 1) % N];
      ring[k] = g * (0.5 * (a + b));
      d[i] = a;
      k = (k + 1) % N;
    }
    const fade = Math.min(len, Math.floor(sr * 0.25));
    for (let i = 0; i < fade; i++) d[len - 1 - i] *= i / fade;
    A.cache.set(midi, buf);
    return buf;
  }

  function playNotes(notes, gapMs, velocity) {
    const a = audio();
    if (!a) return false;
    if (a.ctx.state === 'suspended') a.ctx.resume();
    const t0 = a.ctx.currentTime + 0.03;
    notes.forEach((n, i) => {
      const src = a.ctx.createBufferSource();
      src.buffer = pluckBuffer(n.midi);
      const gain = a.ctx.createGain();
      gain.gain.value = (velocity || 0.8) * (n.midi < 50 ? 0.9 : 0.75);
      src.connect(gain); gain.connect(a.out);
      src.start(t0 + (i * (gapMs || 0)) / 1000);
    });
    return true;
  }

  // ================================================================ rendering helpers

  const FRETS = 15;
  const NECK = { x0: 62, w: 1060, top: 22, gap: 28 };
  const fretX = (n) => NECK.x0 + (NECK.w - NECK.x0) * ((1 - Math.pow(2, -n / 12)) / (1 - Math.pow(2, -FRETS / 12)));
  const noteX = (f) => (f === 0 ? NECK.x0 - 20 : (fretX(f - 1) + fretX(f)) / 2);
  const strY = (s) => NECK.top + (5 - s) * NECK.gap; // low E at the bottom, like tab

  function neckSvg(marks, opts) {
    const H = NECK.top * 2 + NECK.gap * 5;
    let g = `<defs><linearGradient id="cl-wood" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#4a2a1b"/><stop offset=".5" stop-color="#2e1a10"/><stop offset="1" stop-color="#3b2216"/></linearGradient>
      <linearGradient id="cl-bronze" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#b98d4e"/><stop offset=".5" stop-color="#e3c48d"/><stop offset="1" stop-color="#b98d4e"/></linearGradient></defs>`;
    g += `<rect x="${NECK.x0}" y="${NECK.top - 12}" width="${NECK.w - NECK.x0 + 6}" height="${NECK.gap * 5 + 24}" rx="4" fill="url(#cl-wood)" stroke="#e8dcc0" stroke-width="2"/>`;
    [3, 5, 7, 9, 15].forEach((f) => (g += `<circle cx="${noteX(f)}" cy="${strY(2.5)}" r="6" fill="#e8dcc0" opacity=".55"/>`));
    g += `<circle cx="${noteX(12)}" cy="${strY(1.5)}" r="6" fill="#e8dcc0" opacity=".55"/><circle cx="${noteX(12)}" cy="${strY(3.5)}" r="6" fill="#e8dcc0" opacity=".55"/>`;
    g += `<rect x="${NECK.x0 - 6}" y="${NECK.top - 12}" width="8" height="${NECK.gap * 5 + 24}" fill="#f1e9d6"/>`;
    for (let f = 1; f <= FRETS; f++) g += `<line x1="${fretX(f)}" x2="${fretX(f)}" y1="${NECK.top - 12}" y2="${NECK.top + NECK.gap * 5 + 12}" stroke="var(--fretc)" stroke-width="2.4"/>`;
    for (let f = 1; f <= FRETS; f++) if ([3, 5, 7, 9, 12, 15].includes(f)) g += `<text x="${noteX(f)}" y="${H + 2}" fill="#bfb3a0" font-size="12" text-anchor="middle">${f}</text>`;
    for (let s = 0; s < 6; s++) g += `<line class="str" data-s="${s}" x1="${NECK.x0 - 4}" x2="${NECK.w + 6}" y1="${strY(s)}" y2="${strY(s)}" stroke="url(#cl-bronze)" stroke-width="${(3.4 - s * 0.45).toFixed(2)}"/>`;
    (opts.muted || []).forEach((s) => (g += `<text x="${NECK.x0 - 22}" y="${strY(s)}" fill="#d0c6b4" font-size="15" text-anchor="middle" dominant-baseline="central">×</text>`));
    (opts.tuningNames || []).forEach((n, s) => (g += `<text x="${12}" y="${strY(s)}" fill="#bfb3a0" font-size="12" text-anchor="middle" dominant-baseline="central">${esc(n)}</text>`));
    marks.forEach((m) => {
      const fill = m.cls === 'r' ? 'var(--deg-r)' : m.cls === '3' ? 'var(--deg-3)' : m.cls === '5' ? 'var(--deg-5)' : m.cls === '7' ? 'var(--deg-7)' : m.cls === 'x' ? 'var(--deg-x)' : 'var(--dot)';
      const open = m.f === 0;
      g += `<g class="nd" data-midi="${m.midi}" data-s="${m.s}"><circle cx="${noteX(m.f)}" cy="${strY(m.s)}" r="${m.small ? 8 : 11}" fill="${open ? '#1c120b' : fill}" stroke="${fill}" stroke-width="${open ? 3 : 1.5}" opacity="${m.dim ? 0.45 : 1}"/>
        ${m.text ? `<text x="${noteX(m.f)}" y="${strY(m.s)}" ${open ? `style="fill:${fill}"` : ''}>${esc(m.text)}</text>` : ''}</g>`;
    });
    if (opts.barre) g += `<rect x="${noteX(opts.barre.f) - 6}" y="${strY(opts.barre.to) - 12}" width="12" height="${strY(opts.barre.from) - strY(opts.barre.to) + 24}" rx="6" fill="var(--dot)" opacity=".35"/>`;
    return `<svg class="cl-neck" viewBox="0 0 ${NECK.w + 14} ${H + 10}" role="img" aria-label="${esc(opts.label || 'צוואר הגיטרה')}">${g}</svg>`;
  }

  /** Small chord box (fixed size, works for any position on the neck). */
  function diagramSvg(v, big) {
    const W = 104, H = 124, L = 18, T = 26, G = 14, F = 18;
    const pressed = v.frets.filter((f) => f > 0);
    const lo = pressed.length ? Math.min.apply(null, pressed) : 1;
    const start = Math.max(...pressed.concat([0])) <= 4 ? 1 : lo;
    let g = '';
    if (start === 1) g += `<line class="nut" x1="${L}" x2="${L + 5 * G}" y1="${T}" y2="${T}"/>`;
    else g += `<text class="lab" x="${L - 9}" y="${T + F * 0.6}">${start}</text>`;
    for (let i = 0; i <= 4; i++) g += `<line class="g" x1="${L}" x2="${L + 5 * G}" y1="${T + i * F}" y2="${T + i * F}"/>`;
    for (let s = 0; s < 6; s++) g += `<line class="g" x1="${L + s * G}" x2="${L + s * G}" y1="${T}" y2="${T + 4 * F}"/>`;
    v.frets.forEach((f, s) => {
      const x = L + s * G;
      if (f === null) g += `<text class="lab" x="${x}" y="${T - 8}">×</text>`;
      else if (f === 0) g += `<circle cx="${x}" cy="${T - 11}" r="4" fill="none" stroke="var(--muted)" stroke-width="1.4"/>`;
      else {
        const y = T + (f - start + 0.5) * F;
        g += `<circle class="dt" cx="${x}" cy="${y}" r="6.2"/>${v.fingers[s] ? `<text class="fn" x="${x}" y="${y}">${v.fingers[s]}</text>` : ''}`;
      }
    });
    return `<svg class="cl-dg ${big ? 'big' : ''}" viewBox="0 0 ${W} ${H}" width="${big ? 168 : W}" height="${big ? 200 : H}" aria-hidden="true">${g}</svg>`;
  }

  // ================================================================ UI

  const UI = { root: null, state: null, off: [], cam: { mode: 'player', rx: 50, ry: 0, z: 1 }, timers: [] };
  const CAMS = { player: 'rotateX(34deg) rotateZ(-1.5deg) scale(0.97)', stage: 'rotateX(0deg) scale(1)' };
  const on = (el, ev, fn, o) => { el.addEventListener(ev, fn, o); UI.off.push(() => el.removeEventListener(ev, fn, o)); };
  const later = (fn, ms) => { const t = setTimeout(fn, ms); UI.timers.push(t); return t; };

  function mount(root, opts) {
    unmount();
    const store = env.store;
    const saved = (store && store.get('lab', null)) || {};
    UI.root = root;
    UI.state = {
      tab: (opts && opts.tab) || saved.tab || 'chord',
      root: saved.root || 'C', suffix: saved.suffix !== undefined ? saved.suffix : '', bass: '',
      tuning: saved.tuning || 'std', vi: 0, label: saved.label || 'finger', all: !!saved.all, cat: '', mineAll: false,
      songChords: (opts && Array.isArray(opts.songChords) ? opts.songChords : []).filter((c) => parse(c)).slice(0, 24), songName: (opts && opts.songName) || '',
      scaleRoot: saved.scaleRoot || 'A', scale: saved.scale || 'pentaMin', scaleLabel: saved.scaleLabel || 'deg',
    };
    const phone = typeof window !== 'undefined' && window.matchMedia && window.matchMedia('(max-width: 760px)').matches;
    UI.cam = Object.assign({ mode: phone ? 'stage' : 'player', rx: 35, ry: -18, z: 1 }, saved.cam && saved.cam.mode ? { mode: saved.cam.mode } : {});
    if (opts && opts.chord) {
      const p = parse(opts.chord);
      if (p) Object.assign(UI.state, { tab: 'chord', root: p.root, suffix: p.suffix, bass: p.bass, vi: 0 });
    }
    root.classList.add('cl');
    on(root, 'click', onClick);
    on(root, 'change', onChange);
    on(root, 'keydown', (e) => { if (e.target.id === 'cl-q' && e.key === 'Enter') { e.preventDefault(); applyQuery(e.target.value); } });
    on(root, 'input', (e) => {
      if (e.target.id !== 'cl-q') return;
      clearTimeout(UI.typeT);
      const val = e.target.value;
      UI.typeT = later(() => {
        // Only while the player is still typing there; a click in between wins.
        if (!UI.root || !document.activeElement || document.activeElement.id !== 'cl-q') return;
        const p = parse(val); if (p && p.symbol !== current().symbol) { Object.assign(UI.state, { root: p.root, suffix: p.suffix, bass: p.bass, vi: 0, cat: '' }); draw(true); } }, 350);
    });
    on(document, 'keydown', (e) => {
      if (!UI.root || UI.state.tab !== 'chord' || /INPUT|TEXTAREA|SELECT/.test((document.activeElement || {}).tagName || '')) return;
      if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') { e.preventDefault(); stepVoicing(e.key === 'ArrowLeft' ? 1 : -1); }
      else if (e.key === ' ') { e.preventDefault(); play('down'); }
    });
    draw();
  }

  function unmount() {
    UI.off.forEach((f) => f());
    UI.off = [];
    UI.timers.forEach((t) => clearTimeout(t));
    UI.timers = [];
    if (A.ctx) { try { A.ctx.close(); } catch (e) { /* already closed */ } }
    A.ctx = null; A.out = null; A.cache.clear();
    if (UI.root) { UI.root.classList.remove('cl'); UI.root = null; }
  }

  function save() {
    const s = UI.state;
    if (env.store) env.store.set('lab', { tab: s.tab, root: s.root, suffix: s.suffix, tuning: s.tuning, label: s.label, all: s.all, scaleRoot: s.scaleRoot, scale: s.scale, scaleLabel: s.scaleLabel, cam: { mode: UI.cam.mode } });
  }

  function current() {
    const s = UI.state;
    return parse(s.root + s.suffix + (s.bass ? '/' + s.bass : '')) || parse('C');
  }

  function applyQuery(text) {
    const p = parse(text);
    const box = UI.root.querySelector('#cl-qmsg');
    if (!p) { if (box) box.textContent = 'לא זוהה אקורד. דוגמאות: Am7, F#m7b5, C/E, Gsus4, Bbmaj9'; return; }
    Object.assign(UI.state, { root: p.root, suffix: p.suffix, bass: p.bass, vi: 0, cat: '' });
    draw();
  }

  function stepVoicing(d) {
    const vs = voicings(current(), UI.state.tuning, 8);
    if (!vs.length) return;
    UI.state.vi = (Math.min(UI.state.vi, vs.length - 1) + d + vs.length) % vs.length;
    UI.state.all = false;
    draw();
    play('down');
  }

  function camTransform() {
    const c = UI.cam;
    if (c.mode === 'orbit') return `rotateX(${c.rx}deg) rotateY(${c.ry}deg) scale(${c.z})`;
    return CAMS[c.mode] || CAMS.player;
  }

  function draw(keepTyping) {
    if (!UI.root) return;
    const s = UI.state;
    const typing = keepTyping && document.activeElement && document.activeElement.id === 'cl-q' ? document.activeElement.value : null;
    const tabs = `<div class="cl-tabs" role="tablist"><button class="cl-tab ${s.tab === 'chord' ? 'on' : ''}" data-cl="tab" data-v="chord">🎸 אקורדים</button>
      <button class="cl-tab ${s.tab === 'neck' ? 'on' : ''}" data-cl="tab" data-v="neck">🗺 חקר הלוח וסולמות</button></div>`;
    const tuning = `<div class="cl-row"><span class="lbl">כיוון</span><select id="cl-tuning" aria-label="כיוון הגיטרה">${TUNINGS.map((t) => `<option value="${t.id}" ${t.id === s.tuning ? 'selected' : ''}>${esc(t.he)} · ${esc(t.label)}</option>`).join('')}</select></div>`;
    const cams = `<div class="cl-cams" role="group" aria-label="זווית מבט">
      ${[['player', '👁 מבט נגן'], ['stage', '🎤 מבט חזיתי'], ['orbit', '🔄 סיבוב חופשי']].map(([m, l]) => `<button class="btn btn-sm ${UI.cam.mode === m ? 'btn-accent' : ''}" data-cl="cam" data-v="${m}">${l}</button>`).join('')}
      ${UI.cam.mode === 'orbit' ? '<span class="cl-note">גרירה לסיבוב · גלגלת / צביטה לזום</span>' : ''}</div>`;
    const head = `<div class="page-head"><div><h1>ספריית אקורדים</h1><div class="muted">אקורדים, היפוכים, CAGED וסולמות — עם צליל</div></div></div>`;
    UI.root.innerHTML = head + tabs + (s.tab === 'neck' ? neckTab(tuning, cams) : chordTab(tuning, cams));
    if (typing !== null) { const q = UI.root.querySelector('#cl-q'); if (q) { q.value = typing; q.focus(); q.setSelectionRange(typing.length, typing.length); } }
    bindStage();
  }

  function chordTab(tuningRow, cams) {
    const s = UI.state;
    const ch = current();
    const d = describe(ch);
    const vs = voicings(ch, s.tuning, 8);
    const v = vs[Math.min(s.vi, vs.length - 1)];
    const tuning = tuningById(s.tuning);
    const mine = libraryChords(env.songs ? env.songs() : []).slice(0, 40);
    let marks;
    let barre = null;
    if (s.all || !v) {
      marks = neckMap(ch.rootPc, ch.quality.iv, s.tuning, FRETS).map((m) => ({ s: m.s, f: m.f, midi: m.midi, cls: degClass(m.deg), text: s.label === 'note' ? noteName(m.midi, /b/.test(ch.root)) : m.deg, small: true }));
    } else {
      marks = v.frets.map((f, st) => (f === null ? null : { s: st, f, midi: tuning.midi[st] + f, cls: degClass(degreeLabel(pc(tuning.midi[st] + f - ch.rootPc), ch.quality.iv)),
        text: s.label === 'finger' ? (v.fingers[st] || '') : s.label === 'note' ? noteName(tuning.midi[st] + f, /b/.test(ch.root)) : degreeLabel(pc(tuning.midi[st] + f - ch.rootPc), ch.quality.iv) })).filter(Boolean);
      if (v.barre) {
        const bs = v.fingers.map((x, st) => (x === 1 ? st : -1)).filter((x) => x >= 0);
        barre = { f: v.frets[bs[0]], from: bs[0], to: bs[bs.length - 1] };
      }
    }
    const muted = !s.all && v ? v.frets.map((f, i) => (f === null ? i : -1)).filter((i) => i >= 0) : [];
    const vi = Math.min(s.vi, Math.max(0, vs.length - 1));
    const cat = s.cat || categoryOf(s.suffix);
    const catQ = (CATEGORIES.find((c) => c.id === cat) || CATEGORIES[0]).list.map((x) => BY_SUFFIX[x]);
    const mineShown = s.mineAll ? mine : mine.slice(0, 12);
    const chip = (sym, extra, sub) => `<button class="cl-pill ${sym === ch.symbol ? 'on' : ''}" data-cl="pick" data-v="${esc(sym)}">${esc(sym)}${sub !== undefined ? `<small>${esc(sub)}</small>` : ''}</button>`;
    const fam = diatonic(ch);
    const si = s.songChords.indexOf(ch.symbol);
    return `
      <section class="cl-hero" aria-label="האקורד">
        <div class="cl-hero-main">
          <div class="cl-title"><span class="cl-name">${esc(ch.symbol)}</span><span class="cl-he">${esc(d.he)}</span>
            <span class="cl-shift"><button class="cl-sm" data-cl="shift" data-v="-1" aria-label="חצי טון למטה" title="חצי טון למטה">−½</button><button class="cl-sm" data-cl="shift" data-v="1" aria-label="חצי טון למעלה" title="חצי טון למעלה">+½</button></span></div>
          <div class="cl-info">
            <span class="cl-fact"><b>צלילים</b> <bdi>${esc(d.notes.join(' · '))}</bdi></span>
            <span class="cl-fact"><b>נוסחה</b> <bdi>${esc(d.formula)}</bdi></span>
            <span class="cl-fact"><b>${esc(d.inversion)}</b></span>
            ${v && v.caged ? `<span class="cl-fact"><b>CAGED</b> <bdi>${esc(v.caged)}</bdi></span>` : ''}
          </div>
          <div class="cl-play">
            <button class="btn btn-accent" data-cl="play" data-v="down" ${v ? '' : 'disabled'}>▼ פריטה</button>
            <button class="btn" data-cl="play" data-v="up" ${v ? '' : 'disabled'} aria-label="פריטה למעלה">▲</button>
            <button class="btn" data-cl="play" data-v="arp" ${v ? '' : 'disabled'}>🎼 ארפג׳ו</button>
            <button class="btn" data-cl="play" data-v="travis" ${v ? '' : 'disabled'}>Travis</button></div>
        </div>
        <div class="cl-hero-dg">
          ${v ? `<button class="cl-arrow" data-cl="vstep" data-v="-1" aria-label="המיקום הקודם">‹</button>
          <div class="cl-bigdg" data-cl="play" data-v="down" role="button" aria-label="נגן">${diagramSvg(v, true)}
            <div class="cl-pos">מיקום ${vi + 1} מתוך ${vs.length} · ${v.base ? 'שריג ' + v.base : 'פתוח'}${v.barre ? ' · ברה' : ''}</div></div>
          <button class="cl-arrow" data-cl="vstep" data-v="1" aria-label="המיקום הבא">›</button>` : '<div class="muted">לא נמצאה אצבוע נוחה בכיוון הזה</div>'}
        </div>
