      ${mine.length ? `<div class="cl-strip-h">מהשירים שלי <span class="muted">(${mine.length})</span>${mine.length > 12 ? `<button class="cl-sm" data-cl="mine-all">${s.mineAll ? 'פחות' : 'הכל'}</button>` : ''}</div>
        <div class="cl-wrap">${mineShown.map((m) => chip(m.chord, '', m.count)).join('')}</div>` : ''}
