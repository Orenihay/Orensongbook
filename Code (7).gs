        ${diagramSvg(x)}<div class="f ${x.frets.some((f) => f >= 10) ? 'tight' : ''}">${x.frets.map((f) => (f === null ? 'x' : f)).join(' ')}</div><div class="t">${x.base ? 'שריג ' + x.base : 'פתוח'}${x.caged ? ' · ' + x.caged : ''}</div></button>`).join('')}</div>

