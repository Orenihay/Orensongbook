  const ALIAS = {
    M: '', maj: '', major: '', min: 'm', mi: 'm', '-': 'm', minor: 'm', M7: 'maj7', Maj7: 'maj7', 'Δ': 'maj7', 'Δ7': 'maj7', ma7: 'maj7',
