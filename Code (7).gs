  const name = (p, flats) => (flats ? FLAT : SHARP)[pc(p)];

  /** "C#m7b5/G" -> { root, rootPc, suffix, quality, bass, bassPc } or null. */
  function parse(text) {
    const t = String(text || '').trim().replace(/♯/g, '#').replace(/♭/g, 'b');
