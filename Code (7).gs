    if (code === 401) throw new Error('מפתח ה-API של Claude אינו תקין (ANTHROPIC_API_KEY).');
    if (code === 429 || code === 529) throw new Error('שירות ה-AI עמוס כרגע. הזיהוי הבסיסי נשאר; נסה שוב בעוד רגע.');
    throw new Error('זיהוי AI נכשל: ' + msg);
  }
  if (data.stop_reason === 'refusal') throw new Error('שירות ה-AI סירב לנתח את הטקסט הזה. הזיהוי הבסיסי נשאר.');
